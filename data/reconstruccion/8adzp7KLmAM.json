 "seg": [
  [
   0.0,
   "Ar lan Iorddonen ddofn"
  ],
  [
   6.7,
   "'R wy'n oedi'n nychlyd,"
  ],
  [
   12.2,
   "Mewn blys mynd trwy, ac ofn"
  ],
  [
   18.9,
   "Ei stormydd enbyd:"
  ],
  [
   24.5,
   "O! na bai modd i mi"
  ],
  [
   31.2,
   "Osgoi ei hymchwydd hi,"
  ],
  [
   37.8,
   "A hedfan uwch ei lli"
  ],
  [
   44.5,
   "I'r Ganaan hyfryd."
  ],
  [
   50.1,
   "Wrth gofio grym y dŵr,"
  ],
  [
   54.5,
   "A'i thonnog genlli"
  ],
  [
   61.2,
   "A'r mynych rymus ŵr"
  ],
  [
   66.8,
   "A suddodd ynddi,"
  ],
  [
   72.3,
   "Mae braw ar f'enaid gwan"
  ],
  [
   79.0,
   "Mai boddi fydd fy rhan,"
  ],
  [
   85.7,
   "Cyn cyrraedd tawel lan"
  ],
  [
   92.4,
   "Bro y goleuni."
  ],
  [
   97.9,
   "Ond pan wy'n gweled draw"
  ],
  [
   104.6,
   "Ar fynydd Seion,"
  ],
  [
   109.1,
   "Yn iach, heb boen na braw,"
  ],
  [
   115.7,
   "Fy hen gyfeillion,"
  ],
  [
   121.3,
   "Paham yr ofnaf mwy?"
  ],
  [
   128.0,
   "Y Duw a'u daliodd hwy"
  ],
  [
   135.8,
   "A'm dyga innau drwy"
  ],
  [
   142.4,
   "Ei dyfroedd dyfnion."
  ]
 ],
