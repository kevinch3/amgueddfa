{"src":"reconstruida","lang":"es","seg":[[30.0,"Las manos de mi madre"],[31.6,"parecen pájaros en el aire."],[33.8,"Historias de cocina"],[35.4,"entre sus alas heridas de hambre."],[37.9,"Las manos de mi madre"],[39.5,"saben que ocurre por las mañanas"],[42.0,"cuando amasan la vida"],[47.1,"horno de barro, pan de esperanza."],[54.0,"Las manos de mi madre"],[57.1,"llegan al patio desde temprano"],[61.5,"todo se vuelve fiesta"],[64.6,"cuando ellas vuelan junto a otros pájaros."],[70.8,"Junto a los pájaros que aman la vida"],[75.1,"y la construyen con el trabajo."],[78.0,"Arde la leña, harina y barro."],[101.5,"Lo cotidiano se vuelve mágico."],[125.0,"Las manos de mi madre"],[130.1,"me representan un cielo abierto"],[138.0,"y un recuerdo añorado"],[156.9,"trapos calientes en los inviernos."],[178.0,"Ellas se brindan cálidas"],[182.0,"nobles, sinceras, limpias de todo."],[186.9,"¿Cómo serán las manos"],[192.7,"del que las mueve gracias al odio?"],[197.0,"Arde la leña, harina y barro, lo cotidiano se vuelve mágico."]],"fuentes":[["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["whisper_es"]],"letras":[{"desde":17,"hasta":212,"titulo":"Como pájaros en el aire","autor":"Peteco Carabajal, arr. Liliana Cangiano","idioma":"es","derechos":"Derechos confirmados por el mantenedor del archivo","fuente":"Aportado por Kevin Roberts"}]}