{"src":"reconstruida","lang":"es","seg":[[30.0,"Vengo desde el olvido,"],[44.8,"toro serrano,"],[54.0,"pa' ver si mato penas"],[63.7,"carnavaleando."],[70.6,"Me anda faltando plata,"],[81.7,"chicha y coraje"],[90.02,"y un empujón del diablo"],[95.0,"pa' enamorarte."],[98.7,"Carnavales carperos:"],[103.1,"la copla y la albahaca"],[108.7,"llorando en el vino."],[113.02,"Los caballos atados"],[129.1,"vuelven a la luna,"],[142.8,"a galope tendido."],[158.9,"Quiero bailar la zamba"],[175.0,"los dos solitos,"],[186.4,"para trampearte el alma"],[204.8,"con mi gualicho."],[216.2,"Tu pañuelito blanco"],[232.3,"busca consuelo;"],[243.8,"mi corazón lo sigue,"],[248.78,"Vuelven a la luna, a la noche del día."],[259.82,"de vuelo en vuelo."]],"fuentes":[["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["whisper_es"],["letra"]],"letras":[{"desde":25,"hasta":272,"titulo":"Zamba del carnaval","autor":"Cuchi Leguizamón, versión coral Pablo D. Roberto","idioma":"es","derechos":"Derechos confirmados por el mantenedor del archivo","fuente":"Aportado por Kevin Roberts"}],"exportado":"2026-11-23T23:11:50Z"}