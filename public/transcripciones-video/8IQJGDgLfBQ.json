{"src":"reconstruida","lang":"cy","seg":[[0.0,"Moloneg o ran, brenin mawr yn hen, creuwr o ffynhau, ddawn i dadi'n hen."],[28.0,"Molwn enw'r Arglwydd,"],[28.0,"Brenin mawr y nef;"],[31.4,"Crëwr a Chynhaliwr"],[34.7,"Bywyd ydyw ef:"],[38.1,"Llechwn yn ei gysgod"],[41.5,"Pa beth bynnag ddaw,"],[44.9,"Nerthoedd nef a daear"],[48.2,"Geidw yn ei law."],[50.9,"Molwn enw'r Arglwydd,"],[53.6,"Sanctaidd yw efe,"],[57.0,"Llewyrch ei wynepryd"],[62.6,"Yw goleuni'r ne';"],[67.3,"Enfyn ef ei Ysbryd"],[72.9,"I sancteiddio dyn,"],[77.6,"Nes bod daear gyfan"],[82.3,"Fel y nef ei hun."],[87.0,"Molwn enw'r Arglwydd,"],[90.8,"Rhyfedd yw ei ras;"],[95.5,"Lleinw ei drugaredd"],[100.2,"Gyrrau'r ddaear las:"],[104.0,"Pan gyrhaeddwn adref"],[105.1,"Draw tu hwnt i'r llen,"],[106.0,"Molwn enw'r Arglwydd"],[106.9,"Yn y nefoedd wen."],[134.0,"Diolch yn fawr i chi am ddarllen y thema."]],"fuentes":[["cy"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["cy"]],"letras":[{"desde":10,"hasta":129,"titulo":"Molwn enw'r Arglwydd","autor":"John James Williams (1869-1954)","idioma":"cy","derechos":"Texto de dominio público","fuente":"https://gobaith.cymru/angelfire/M%28molwn%29.html, Emynau a Thonau (gobaith.cymru; Y Caniedydd Cynulleidfaol Newydd 1921), estrofas 1, 2 y 4, obtenido por el archivo"}],"exportado":"2026-11-23T13:07:11Z"}