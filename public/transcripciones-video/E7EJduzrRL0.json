{"src":"reconstruida","lang":"es","seg":[[0.0,"Atentamente a Billy"],[30.0,"Aros mae'r mynyddau mawr,"],[38.0,"Rhuo trostynt mae y gwynt;"],[68.0,"Clywir eto gyda'r wawr,"],[74.0,"Gân bugeiliaid megis cynt."],[80.0,"Eto tyfa'r llygad dydd,"],[86.0,"Ogylch traed y graig a'r bryn;"],[92.0,"Ond bugeiliaid newydd sydd"],[107.0,"Ar yr hen fynyddoedd hyn."],[122.0,"Ar arferion Cymru gynt,"],[132.5,"Newid ddaeth o rod i rod;"],[143.0,"Mae cenedlaeth wedi mynd,"],[149.0,"A chenedlaeth wedi dod."],[155.0,"Wedi oes dymestlog hir,"],[161.0,"Alun Mabon mwy nid yw;"],[167.0,"Ond mae'r heniaith yn y tir,"],[173.0,"A'r alawon hen yn fyw."],[181.5,"Ond mae'r heniaith yn y tir,"],[190.0,"A'r alawon hen yn fyw."]],"fuentes":[["whisper_es"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"]],"letras":[{"desde":25,"hasta":205,"titulo":"Aros mae'r Mynyddau Mawr","autor":"Meirion Williams; geiriau Ceiriog (o «Alun Mabon»)","idioma":"cy","derechos":"Texto de dominio público","fuente":"https://www.gutenberg.org/ebooks/3500 (Ceiriog, gol. Owen M. Edwards, Cyfres y Fil, 1902; «Alun Mabon», XXVI), obtenido por el archivo"}],"exportado":"2026-11-23T23:11:51Z"}