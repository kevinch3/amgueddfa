{"src":"youtube","lang":"es","seg":[[1.2,"de Irma Cuña Tejendera."],[6.1,"Seguí surdiendo,"],[8.8,"atenta,"],[10.7,"sin preguntas."],[13.4,"La geometría interminable,"],[16.9,"blanco y negro"],[20.1,"de la desilusión y del olvido."],[25.2,"En tu matra antiquísima"],[29.1,"vuelan los pájaros,"],[32.2,"giran las guirnaldas."],[35.2,"Y oscila entre tus dedos incansables"],[39.8,"el zigzag de la víbora,"],[43.6,"las cinco puntas de la estrella"],[49.8,"y pico de pillan tus volcanes."],[55.8,"Seguís entretegiendo,"],[59.4,"te gendera"],[61.5,"las huellas de un ritual que te ha"],[64.6,"perdido."],[67.8,"[Aplausos]"]]}