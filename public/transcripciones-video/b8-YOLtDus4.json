{"src":"reconstruida","lang":"cy","seg":[[12.5,"Quel fior che all' alba ride"],[59.0,"Il sole poi l'uccide,"],[99.8,"E tomba hà nella sera."],[144.0,"i fo."],[146.3,"È un fior la vita, la vita ancora."],[154.0,"na fyd an'go'r."],[185.52,"Lwcason yn awdoron, y perthyn yn sylfaen y Primo Fyr."],[216.1,"L'occaso ha nell' aurora,"],[262.7,"E perde in un sol dì la primavera."]],"fuentes":[["letra"],["letra"],["letra"],["cy"],["letra"],["cy"],["cy"],["letra"],["letra"]],"letras":[{"desde":12.5,"hasta":332.5,"titulo":"Quel fior che all'alba ride","autor":"Georg Friedrich Händel, dueto HWV 192 (1741); texto italiano anónimo","idioma":"it","derechos":"Texto de dominio público","fuente":"https://www.cpdl.org/wiki/index.php/Quel_fior_che_all%27alba_ride,_HWV_192_(George_Frideric_Handel), ChoralWiki (CPDL #06517), obtenido por el archivo"}],"exportado":"2026-11-26T19:44:41Z"}