{"src":"reconstruida","lang":"es","seg":[[0.0,"Cortadera, plumerito,"],[7.6,"¡cuánto nácar en el viento!"],[15.2,"Recuerdos de tus verdores"],[25.5,"me causan un sentimiento."],[35.9,"¡Ay, cuánto te necesito,"],[42.8,"trebolar donde vivía!"],[48.9,"¿Podré volver algún día,"],[53.6,"cortadera, plumerito?"],[58.9,"Por esos campos viví,"],[76.4,"provincia de Buenos Aires."],[85.9,"Y, abanicando los aires,"],[95.2,"por esos años te vi."],[106.2,"Ay, cuánto te necesito de volar donde vivía, podré volver algún día, Cortadera, plumerito."],[127.7,"Ay, cuando te necesito, Cortadera, plumerito."]],"fuentes":[["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["letra"],["whisper_es"],["whisper_es"]],"letras":[{"desde":0,"hasta":143,"titulo":"Cortadera, plumerito","autor":"serie","idioma":"es","derechos":"Derechos confirmados por el mantenedor del archivo","fuente":"Aportado por Kevin Roberts"}]}