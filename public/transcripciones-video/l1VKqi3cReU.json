{"src":"reconstruida","lang":"es","seg":[[21.6,"Escarchangel ganó el alma."],[30.4,"No hablo otra cosa"],[40.5,"que tu"],[51.8,"seré debes ser Aleluya."],[89.7,"la"],[98.4,"pero no duelen como otras"],[109.2,"las cagas del"],[118.1,"corazón. Déjame verte, déjame ver de otra vez."],[147.9,"Sé que estás en mi"],[156.1,"amor, no te conozco."],[167.2,"lugar. No tengo"],[178.2,"cararte y no te puedes amar."],[191.2,"Solo fuego de un instante."],[213.3,"Italia lenguas rojas que tienen con los tordos de tu mirada."],[234.1,"Déjame venir, ven, ven."],[246.5,"Fe yw'r holl beth, be yw'r holl beth."],[255.4,"otra vez."]],"fuentes":[["yt_es"],["yt_es"],["yt_es"],["yt_es"],["yt_es"],["yt_es"],["yt_es"],["yt_es"],["yt_es"],["yt_es"],["yt_es"],["yt_es"],["yt_es"],["yt_es"],["yt_es"],["cy"],["yt_es"]],"exportado":"2026-11-23T07:42:25Z"}