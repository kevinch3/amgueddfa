---
/** The bardic chair (Y Gadair), drawn as a line mark. Decorative. */
interface Props { size?: number }
const { size = 36 } = Astro.props;
---
<svg width={size} height={Math.round(size * 1.25)} viewBox="0 0 32 40" fill="none" stroke="currentColor"
  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d="M7 23V11a9 9 0 0 1 18 0v12" />
  <circle cx="7" cy="9" r="1.6" fill="currentColor" stroke="none" />
  <circle cx="25" cy="9" r="1.6" fill="currentColor" stroke="none" />
  <path d="M11 22v-9a5 5 0 0 1 10 0v9" stroke-width="1.4" />
  <path d="M16 12.5l1.4 2.6-1.4 2.6-1.4-2.6z" fill="currentColor" stroke-width="1" />
  <path d="M4 23h24l-1.5 4h-21z" />
  <path d="M7 27v11M25 27v11M7 33h18" />
</svg>
