---
import { editionItems, editionState, festivals, yearRange } from '../lib/catalog';
import { t } from '../lib/i18n';
import { url } from '../lib/paths';
import GridCell from './GridCell.astro';

const list = festivals();
const blocks = list.map((f) => {
  const [first, last] = yearRange(f.slug);
  // Every year shows, empty ones too, so gaps read at their real length (#188).
  const cells = Array.from({ length: last - first + 1 }, (_, k) => first + k)
    .map((y) => ({ y, state: editionState(f.slug, y), n: editionItems(f.slug, y).length }));
  return { ...f, first, cells };
});
---
<ul class="legend" aria-label={t('inicio.mapa_leyenda')}>
  <li><span class="swatch st-full"></span>{t('estados.full')}</li>
  <li><span class="swatch st-some"></span>{t('estados.some')}</li>
  <li><span class="swatch st-none"></span>{t('estados.none')}</li>
</ul>
{blocks.map((f) => (
  <section class="fest-block" aria-labelledby={`fest-${f.slug}`}>
    <h3 id={`fest-${f.slug}`}><a href={url(`${f.slug}/`)}>{f.name}</a></h3>
    {f.nameCy !== f.name && <p class="cy" lang="cy">{f.nameCy}</p>}
    <ul class="cells" style={`--start:${(f.first % 10) + 1}`}>
      {f.cells.map((c) => <GridCell slug={f.slug} name={f.name} {...c} />)}
    </ul>
    <p class="antes small">{t('festival.antes', { year: f.first })} <a href={url(`contribuir?f=${f.slug}`)} aria-label={t('festival.antes_link_aria', { festival: f.name })}>{t('festival.antes_link')}</a></p>
  </section>
))}
