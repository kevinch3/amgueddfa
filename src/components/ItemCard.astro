---
import { isPublic } from '../lib/visibilidad';
import { thumbUrl } from '../lib/catalog';
import { contentLang, t } from '../lib/i18n';
import { url } from '../lib/paths';
import type { Item } from '../lib/types';

interface Props { item: Item; showYear?: boolean }
const { item, showYear = false } = Astro.props;
const thumb = thumbUrl(item);
---
<li class="card" data-item={item.id}>
  <a href={url(`item/${item.id}/`)}>
    <span class="frame">
      {thumb ? (
        <img src={thumb} alt={t('item.miniatura_alt', { titulo: item.title })} loading="lazy" decoding="async" width="240" height="320" />
      ) : (
        <span class="ph">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            {!isPublic(item)
              ? <path d="M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5z" />
              : <path d="M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h7" />}
          </svg>
          {!isPublic(item) ? t('comun.restringido_corto') : t(`item.tipos.${item.formato}`)}
        </span>
      )}
    </span>
    <span class="t">{showYear && item.fecha.year ? `${item.fecha.year}: ` : ''}<span lang={contentLang()}>{item.title}</span></span>
  </a>
  {(item.fecha.inferred || !isPublic(item)) && (
    <span class="badges">
      {item.fecha.inferred && <span class="badge" title={t('comun.ano_estimado_ayuda')}>{t('comun.ano_estimado')}</span>}
      {!isPublic(item) && <span class="badge badge-restricted">{t('comun.restringido_corto')}</span>}
    </span>
  )}
</li>
