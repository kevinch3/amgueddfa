---
import { editionCatalogState, editionStatus } from '../lib/catalog';
import { t } from '../lib/i18n';
import { url } from '../lib/paths';
import { docCount, stateLabel } from '../lib/site';
import type { EditionState, FestivalSlug } from '../lib/types';

interface Props { slug: FestivalSlug; y: number; state: EditionState; n: number; thumbs: { src: string | null; title: string }[] }
const { slug, y, state, n, thumbs } = Astro.props;
const status = editionStatus(slug, y);
---
<li class={`tl-${state}`} data-coleccion={slug} data-year={y} data-state={state} data-cat-state={editionCatalogState(slug, y)} data-status={status === 'held' ? 'held' : undefined}>
  <a href={url(`${slug}/${y}/`)}>
    <span class="yr">{y}</span>
    <span class="st">{stateLabel(state, status)}{n > 0 && <span class="muted">{` (${docCount(n)})`}</span>}</span>
    {thumbs.length > 0 && (
      <span class="thumbs" aria-hidden="true">
        {thumbs.map((th) => <img src={th.src} alt="" loading="lazy" decoding="async" width="44" height="58" />)}
      </span>
    )}
  </a>
</li>
