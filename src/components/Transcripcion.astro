---
// A standardized transcription: disciplines (h3), age groups (h4), competitions as lists.
// `doc` (the document id) lets scripts/live-transcripciones.ts replace it with the live text.
import { transcriptionRuns } from '../lib/transcripciones';
import { textHash } from '../lib/docmd';
import { contentLang } from '../lib/i18n';

const { text, doc } = Astro.props as { text: string; doc?: string };
const runs = transcriptionRuns(text);
---
<div class="transcripcion" lang={contentLang()} data-doc={doc} data-doc-hash={doc ? textHash(text) : undefined}>
  {runs.map((r) =>
    r.kind === 'list' ? (
      <ul class="tr-lista">
        {r.items.map((i) => <li>{i.n && <span class="tr-n">{i.n}.</span>} {i.text}</li>)}
      </ul>
    ) : r.block.type === 'section' ? <h3>{r.block.text}</h3>
      : r.block.type === 'group' ? <h4>{r.block.text}</h4>
      : <p>{r.block.text}</p>,
  )}
</div>
