---
import { contentLang, t } from '../lib/i18n';

// Titles and channels are the uploaders' own words (WCAG 3.1.2 on translated pages).
const lang = contentLang();
import { splitVideos, videoThumb, videoUrl, type Video } from '../lib/videos';
import VideoPlayer from './VideoPlayer.astro';

// Always rendered (hidden when empty) so live corrections (scripts/live-videos.ts) can move videos in.
// Each card carries its data so the live script and "Informar un error" can read it; live-videos.ts builds the same markup.
interface Props { videos: Video[]; festival: string; year: number }
const { festival, year } = Astro.props;
const { highlights, performances } = splitVideos(Astro.props.videos);
const total = highlights.length + performances.length;
---
<section class="section" aria-labelledby="videos-t" data-videos data-festival={festival} data-year={year} hidden={total === 0}>
  <h2 id="videos-t">{t('videos.titulo')} <span class="muted small">(<span data-videos-n>{total}</span>)</span></h2>
  <p class="measure muted small">{t('videos.ayuda')}</p>
  <ul class="videos" data-videos-lista="destacados" hidden={highlights.length === 0}>
    {highlights.map((v) => (
      <li class="video" data-video={v.id} data-title={v.title} data-channel={v.channel} data-kind={v.kind}>
        <a href={videoUrl(v.id)} rel="noopener" target="_blank">
          <span class="vframe"><img src={videoThumb(v.id)} alt="" loading="lazy" decoding="async" width="320" height="180" /></span>
          <span class="badge">{t(`videos.tipos.${v.kind}`)}</span>
          <span class="t" lang={lang}>{v.title}</span>
          <span class="muted small"><span lang={lang}>{v.channel}</span>{v.year_inferred && <> · {t('comun.ano_estimado')}</>}</span>
        </a>
        <button type="button" class="btn-link small informar-btn" data-informar-video={v.id}>{t('informar.titulo')}</button>
      </li>
    ))}
  </ul>
  <details class="videos-mas" hidden={performances.length === 0}>
    <summary data-videos-actuaciones>{t('videos.actuaciones', { n: performances.length })}</summary>
    <ul class="videos" data-videos-lista="actuaciones">
      {performances.map((v) => (
        <li class="video" data-video={v.id} data-title={v.title} data-channel={v.channel} data-kind={v.kind}>
          <a href={videoUrl(v.id)} rel="noopener" target="_blank">
            <span class="vframe"><img src={videoThumb(v.id)} alt="" loading="lazy" decoding="async" width="320" height="180" /></span>
            <span class="t" lang={lang}>{v.title}</span>
            <span class="muted small"><span lang={lang}>{v.channel}</span>{v.year_inferred && <> · {t('comun.ano_estimado')}</>}</span>
          </a>
          <button type="button" class="btn-link small informar-btn" data-informar-video={v.id}>{t('informar.titulo')}</button>
        </li>
      ))}
    </ul>
  </details>
</section>
<VideoPlayer />
{/* One "Informar un error" dialog per page (outside the section, which may be hidden); scripts/informar.ts fills it. */}
<dialog id="informar-dialogo" class="informar" aria-labelledby="informar-t">
  <div class="informar-head">
    <h2 id="informar-t">{t('informar.titulo')}</h2>
    <button type="button" class="btn-link" data-informar-cerrar>{t('informar.cerrar')}</button>
  </div>
  <p class="muted small" data-informar-sobre></p>
  <div data-informar-cuerpo></div>
</dialog>
