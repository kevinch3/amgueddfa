---
import { t } from '../lib/i18n';
import { url } from '../lib/paths';
import { EDITABLE_FESTIVALS } from '../lib/transcript-draft';

// One player dialog per edition page; scripts/reproductor.ts opens it from any video card
// (the card's link to YouTube stays for no-JS, middle click and "open in new tab").
// YouTube's no-cookie player is created only when a visitor opens a video.
// Chubut and Trevelin pages also carry the edit mode (scripts/editor-transcripcion.ts): collaborators correct the
// transcript line by line and send it as one contribution. No other festival's page has it (#29).
interface Props { festival?: string }
const editable = (EDITABLE_FESTIVALS as readonly string[]).includes(Astro.props.festival ?? '');
---
<dialog id="reproductor" class="reproductor" aria-labelledby="rep-titulo">
  <div class="rep-head">
    <div class="rep-head-t">
      <h2 id="rep-titulo" data-rep-titulo></h2>
      <p class="muted small" data-rep-meta></p>
    </div>
    <div class="rep-nav">
      <button type="button" class="rep-btn" data-rep-anterior aria-label={t('reproductor.anterior')}><span aria-hidden="true">‹</span></button>
      <button type="button" class="rep-btn" data-rep-siguiente aria-label={t('reproductor.siguiente')}><span aria-hidden="true">›</span></button>
      <button type="button" class="rep-btn rep-cerrar" data-rep-cerrar aria-label={t('reproductor.cerrar')} autofocus><span aria-hidden="true">✕</span></button>
    </div>
  </div>
  <div class="rep-cuerpo">
    <div class="rep-video">
      <div class="rep-marco"><div data-rep-player></div></div>
      <p class="rep-error" data-rep-error hidden>{t('reproductor.no_disponible')} <a data-rep-yt-error rel="noopener" target="_blank">{t('reproductor.ver_youtube')}</a></p>
      <section class="rep-capitulos" data-rep-capitulos hidden aria-labelledby="rep-cap-t">
        <h3 id="rep-cap-t">{t('reproductor.capitulos')} <span class="badge">{t('reproductor.automatico')}</span></h3>
        <ol class="rep-cap-lista" data-rep-cap-lista></ol>
        <p class="muted small">{t('reproductor.nota_capitulos')}</p>
      </section>
      <div class="rep-acciones small">
        <a data-rep-yt rel="noopener" target="_blank">{t('reproductor.ver_youtube')}</a>
        <button type="button" class="btn-link small" data-rep-copiar>{t('reproductor.copiar_enlace')}</button>
        <button type="button" class="btn-link small" data-rep-informar>{t('informar.titulo')}</button>
        {editable && <button type="button" class="btn-link small" data-rep-editar hidden>{t('editor.editar')}</button>}
        {editable && <div class="rep-editar-gate" data-rep-editar-gate hidden></div>}
        <span class="muted" data-rep-copiado role="status"></span>
      </div>
    </div>
    <section class="rep-tr" aria-labelledby="rep-tr-t">
      <div class="rep-tr-head">
        <h3 id="rep-tr-t">{t('reproductor.transcripcion')}</h3>
        <span class="badge" data-rep-fuente hidden></span>
      </div>
      <div class="rep-buscar" data-rep-buscador hidden>
        <label for="rep-q" class="sr-only">{t('reproductor.buscar')}</label>
        <div class="rep-buscar-fila">
          <span class="campo-buscar">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" /></svg>
            <input id="rep-q" type="search" autocomplete="off" placeholder={t('reproductor.buscar')} data-rep-q />
          </span>
          <label class="rep-seguir small"><input type="checkbox" data-rep-seguir checked /> {t('reproductor.seguir')}</label>
        </div>
        <p class="muted small" data-rep-n aria-live="polite"></p>
      </div>
      {editable && (
        <section class="rep-editor" data-rep-editor hidden tabindex="-1" aria-label={t('editor.editar')}>
          <p class="muted small rep-ed-ayuda">{t('editor.ayuda')}</p>
          <div class="rep-ed-barra">
            <p class="rep-ed-n" data-editor-n aria-live="polite"></p>
            <button type="button" class="btn-link small" data-editor-agregar></button>
          </div>
          <div data-editor-nueva hidden></div>
          <p class="tarea-acciones">
            <button type="button" class="btn" data-editor-enviar disabled></button>
            <button type="button" class="btn btn-quiet" data-editor-cancelar>{t('editor.cancelar')}</button>
          </p>
          <div class="rep-ed-confirmar" data-editor-confirmar hidden>
            <p>{t('editor.confirmar_cancelar')}</p>
            <p class="tarea-acciones">
              <button type="button" class="btn" data-editor-descartar>{t('editor.descartar')}</button>
              <button type="button" class="btn btn-quiet" data-editor-seguir>{t('editor.seguir')}</button>
            </p>
          </div>
          <p class="contrib-msg" role="alert" data-editor-msg></p>
        </section>
        <div class="rep-ed-estado" data-editor-estado></div>
      )}
      <p class="muted small" data-rep-vacio>{t('reproductor.sin_transcripcion')}</p>
      <ol class="rep-lineas" data-rep-lineas></ol>
      <footer class="rep-pie" data-rep-pie hidden>
        <p data-rep-nota hidden>{t('reproductor.nota_whisper')}</p>
        <div data-rep-creditos hidden>
          <p id="rep-cred-t">{t('reproductor.letras_titulo')}</p>
          <ul class="rep-creditos" data-rep-creditos-lista aria-labelledby="rep-cred-t"></ul>
        </div>
        <p data-rep-colab hidden></p>
        <p><a href={url('creditos#videos')}>{t('reproductor.como_se_produce')}</a></p>
      </footer>
    </section>
  </div>
</dialog>
