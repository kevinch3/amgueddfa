---
import { pageUrls } from '../lib/catalog';
import { t } from '../lib/i18n';
import type { Item } from '../lib/types';

interface Props { item: Item }
const { item } = Astro.props;
const pages = pageUrls(item);
const total = pages.length;
---
{total > 0 && (
  <div class="viewer" data-lb-hash>
    <ol class="pages" aria-label={t('item.visor')}>
      {pages.map((src, i) => (
        <li>
          <a class="page-btn" href={src} data-lb="item" aria-label={t('item.ampliar', { n: i + 1 })}>
            <img
              src={src}
              alt={t('item.imagen_alt', { titulo: item.title, n: i + 1 })}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
            {total > 1 && <span class="pn" aria-hidden="true">{i + 1}/{total}</span>}
          </a>
        </li>
      ))}
    </ol>
  </div>
)}
