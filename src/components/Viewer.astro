---
import { pageUrls } from '../lib/catalog';
import { t } from '../lib/i18n';
import type { Item } from '../lib/types';

interface Props { item: Item }
const { item } = Astro.props;
const pages = pageUrls(item);
const total = pages.length;
---
{total > 0 && (
  <div class="viewer" data-viewer data-label={t('item.pagina', { n: '{n}', total: '{total}' })}>
    <ol class="pages" aria-label={t('item.visor')}>
      {pages.map((src, i) => (
        <li>
          <button type="button" class="page-btn" data-index={i} aria-label={t('item.ampliar', { n: i + 1 })}>
            <img
              src={src}
              alt={t('item.imagen_alt', { titulo: item.title, n: i + 1 })}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
            {total > 1 && <span class="pn" aria-hidden="true">{i + 1}/{total}</span>}
          </button>
        </li>
      ))}
    </ol>
    <dialog class="lightbox" aria-label={t('item.visor')}>
      <div class="lb-bar">
        <span class="lb-count" aria-live="polite"></span>
        <span class="lb-tools">
          <button type="button" class="lb-btn lb-zoom" aria-pressed="false" data-more={t('item.ver_grande')} data-less={t('item.ver_entera')}>{t('item.ver_grande')}</button>
          <button type="button" class="lb-btn lb-close">{t('item.cerrar')}</button>
        </span>
      </div>
      <div class="lb-stage"><img alt="" /></div>
      <div class="lb-nav">
        <button type="button" class="lb-btn lb-prev">{t('item.pag_anterior')}</button>
        <button type="button" class="lb-btn lb-next">{t('item.pag_siguiente')}</button>
      </div>
    </dialog>
  </div>
)}

<script>
  // Lightbox over the page images: tap to open, arrows / swipe to move, Esc to close.
  for (const root of document.querySelectorAll<HTMLElement>('[data-viewer]')) {
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('.page-btn')];
    const imgs = thumbs.map((b) => b.querySelector('img') as HTMLImageElement);
    const dlg = root.querySelector('dialog') as HTMLDialogElement;
    const big = dlg.querySelector('.lb-stage img') as HTMLImageElement;
    const count = dlg.querySelector('.lb-count') as HTMLElement;
    const prev = dlg.querySelector('.lb-prev') as HTMLButtonElement;
    const next = dlg.querySelector('.lb-next') as HTMLButtonElement;
    const label = root.dataset.label ?? '';
    const stage = dlg.querySelector('.lb-stage') as HTMLElement;
    const zoomBtn = dlg.querySelector('.lb-zoom') as HTMLButtonElement;
    const setZoom = (on: boolean) => {
      stage.classList.toggle('zoomed', on);
      zoomBtn.setAttribute('aria-pressed', String(on));
      zoomBtn.textContent = (on ? zoomBtn.dataset.less : zoomBtn.dataset.more) ?? '';
      stage.scrollTo(0, 0);
    };
    zoomBtn.addEventListener('click', () => setZoom(!stage.classList.contains('zoomed')));
    big.addEventListener('click', () => setZoom(!stage.classList.contains('zoomed')));
    let cur = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      cur = Math.max(0, Math.min(imgs.length - 1, i));
      setZoom(false);
      big.src = imgs[cur].currentSrc || imgs[cur].src;
      big.alt = imgs[cur].alt;
      count.textContent = label.replace('{n}', String(cur + 1)).replace('{total}', String(imgs.length));
      prev.disabled = cur === 0;
      next.disabled = cur === imgs.length - 1;
      prev.hidden = next.hidden = imgs.length < 2;
    };

    thumbs.forEach((b, i) =>
      b.addEventListener('click', () => {
        opener = b;
        show(i);
        dlg.showModal();
      }),
    );
    prev.addEventListener('click', () => show(cur - 1));
    next.addEventListener('click', () => show(cur + 1));
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('close', () => {
      thumbs[cur]?.scrollIntoView({ block: 'nearest' });
      (thumbs[cur] ?? opener)?.focus();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(cur - 1);
      else if (e.key === 'ArrowRight') show(cur + 1);
    });

    // Swipe: a mostly horizontal single-finger move of 50 px or more turns the page.
    let x0 = 0;
    let y0 = 0;
    let multi = false;
    stage.addEventListener('touchstart', (e) => {
      multi = e.touches.length > 1;
      x0 = e.touches[0].clientX;
      y0 = e.touches[0].clientY;
    }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (multi || stage.classList.contains('zoomed') || (window.visualViewport && window.visualViewport.scale > 1.05)) return;
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(cur + (dx < 0 ? 1 : -1));
    });
  }
</script>
