---
import '../styles/global.css';
import Chair from '../components/Chair.astro';
import Mount from '../components/Mount.astro';
import SessionBadge from '../components/SessionBadge.astro';
import { t } from '../lib/i18n';
import { url } from '../lib/paths';
import { jsonForScript } from '../lib/contrib';
import { absUrl } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  festival?: string;
  year?: number | null;
  item?: string;
  current?: 'inicio' | 'faltantes' | 'tareas' | 'ranking';
  /** Absolute or site path of the page's preview image (cover, thumbnail). */
  image?: string | null;
  /** Keep the page out of search results (private or utility pages). */
  noindex?: boolean;
  /** schema.org data describing the page. */
  jsonLd?: Record<string, unknown> | null;
}
const { title, description = t('sitio.descripcion'), festival, year, item, current, image = null, noindex = false, jsonLd = null } = Astro.props;
const fullTitle = title ? `${title} | ${t('sitio.nombre')}` : t('sitio.nombre');
const canonical = absUrl(Astro.url.pathname);
const ogImage = image ? absUrl(image) : null;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={t('sitio.nombre')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {jsonLd && <script type="application/ld+json" set:html={jsonForScript(jsonLd)} />}
    <meta name="theme-color" content="#9e1b22" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip" href="#contenido">{t('nav.saltar')}</a>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href={url('/')}>
          <Chair size={30} />
          <span class="brand-name">{t('sitio.nombre')}<span>{t('sitio.subtitulo')}</span></span>
        </a>
        <nav class="site-nav" aria-label={t('nav.principal')}>
          <ul>
            <li><a href={url('/')} aria-current={current === 'inicio' ? 'page' : undefined}>{t('nav.inicio')}</a></li>
            <li><a href={url('/#buscados')}>{t('nav.faltantes')}</a></li>
            <li><a href={url('tareas')} aria-current={current === 'tareas' ? 'page' : undefined}>{t('nav.tareas')}</a></li>
            <li><a href={url('ranking')} aria-current={current === 'ranking' ? 'page' : undefined}>{t('nav.ranking')}</a></li>
          </ul>
        </nav>
        <Mount id="sesion" festival={festival} year={year} item={item} />
        <SessionBadge />
      </div>
    </header>
    <div class="scales" aria-hidden="true"></div>
    <main id="contenido" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <p>{t('pie.retiro')}</p>
        <p class="contacto">
          <img src={url('contacto.png')} alt={t('pie.contacto_alt')} width="182" height="24" decoding="async" />
          <span id="contacto-mail"></span>
        </p>
      </div>
    </footer>
  </body>
</html>
