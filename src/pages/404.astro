---
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
import { url } from '../lib/paths';
---
<Base title={t('no_encontrada.titulo')}>
  <section id="no-encontrada" data-base={import.meta.env.BASE_URL ?? '/'}>
    <h1>{t('no_encontrada.titulo')}</h1>
    <p>{t('no_encontrada.texto')}</p>
    <p><a href={url('')}>{t('no_encontrada.inicio')}</a></p>
  </section>
</Base>

<script>
  // An early year whose page is built only after its first approved contribution
  // (links from the contribute form, the profile or the recent feed).
  import { t } from '../lib/i18n';
  import { url } from '../lib/paths';
  import { editionFromPath } from '../lib/timeline';

  const box = document.getElementById('no-encontrada')!;
  const ed = editionFromPath(location.pathname, box.dataset.base ?? '/');
  if (ed) {
    const festival = t(`festivales.${ed.festival}`);
    const h = document.createElement('h1');
    h.textContent = t('no_encontrada.edicion_titulo', { festival, year: ed.year });
    const p = document.createElement('p');
    p.textContent = t('no_encontrada.edicion_texto');
    const links = document.createElement('p');
    const a1 = Object.assign(document.createElement('a'), { href: url(`${ed.festival}/`), textContent: t('no_encontrada.ver_festival', { festival }) });
    const a2 = Object.assign(document.createElement('a'), { href: url(`contribuir?f=${ed.festival}&y=${ed.year}`), textContent: t('no_encontrada.contribuir', { year: ed.year }), className: 'btn' });
    links.append(a2, ' ', a1);
    box.replaceChildren(h, p, links);
  }
</script>
