---
import Base from '../layouts/Base.astro';
import { DEFAULT_LOCALE, LOCALES, locale, t } from '../lib/i18n';
import { EISTEDDFOD_SEGMENTS, url } from '../lib/paths';
import { DEEP_PREFIXES, LANG_PARAM } from '../lib/pagina-unica';

// GitHub Pages answers every missing address with the Spanish /404.html, /cy/… ones
// included. That page hops to the 404 in the address's language (/cy/404/), which
// puts the asked-for address back in the bar, so the script below still reads it.
const isDefault = locale() === DEFAULT_LOCALE;
const base = import.meta.env.BASE_URL ?? '/';
const others = LOCALES.filter((l) => l !== DEFAULT_LOCALE);
// First path segments that moved under /eisteddfod/ (#189); the home ('') is the hub now.
const moved = [...EISTEDDFOD_SEGMENTS].filter(Boolean);
// Deep pages are built once, in Spanish (docs/reglas.md, rule 4): /cy/eisteddfod/item/x/ → /eisteddfod/item/x/?l=cy.
const deeps = [...DEEP_PREFIXES];
const param = LANG_PARAM;
---
<Base title={t('no_encontrada.titulo')} noindex>
  <Fragment slot="head">
    {isDefault ? (
      <script is:inline define:vars={{ base, others, moved, deeps, param }}>
        (function () {
          var b = base.replace(/\/+$/, '') + '/';
          var path = location.pathname;
          // An old Eisteddfod address the build has no forwarding page for (#189):
          // insert the collection, keeping the language, query and hash.
          var rest = path.indexOf(b) === 0 ? path.slice(b.length) : '';
          var parts = rest.split('/');
          var lead = others.indexOf(parts[0]) >= 0 ? parts.shift() : '';
          var page = (moved.indexOf(parts[0]) >= 0 ? 'eisteddfod/' : '') + parts.join('/');
          var deep = deeps.some(function (d) { return page.indexOf(d) === 0 && page.length > d.length; });
          if (lead && deep) {
            var q = new URLSearchParams(location.search);
            q.set(param, lead);
            location.replace(b + page + '?' + q.toString() + location.hash);
            return;
          }
          if (page !== parts.join('/')) {
            location.replace(b + (lead ? lead + '/' : '') + page + location.search + location.hash);
            return;
          }
          var first = path.indexOf(b) === 0 ? path.slice(b.length).split('/')[0] : '';
          if (others.indexOf(first) >= 0 && path.slice(b.length).replace(/\/+$/, '') !== first + '/404') {
            location.replace(b + first + '/404/?desde=' + encodeURIComponent(path + location.search + location.hash));
          }
        })();
      </script>
    ) : (
      <script is:inline>
        (function () {
          var d = new URLSearchParams(location.search).get('desde');
          if (d && d.charAt(0) === '/' && d.charAt(1) !== '/') {
            try { history.replaceState(null, '', d); } catch (e) { /* stay on /xx/404/ */ }
          }
        })();
      </script>
    )}
  </Fragment>
  <section id="no-encontrada" data-base={import.meta.env.BASE_URL ?? '/'}>
    <h1>{t('no_encontrada.titulo')}</h1>
    <p>{t('no_encontrada.texto')}</p>
    <p><a href={url('')}>{t('no_encontrada.inicio')}</a></p>
  </section>
</Base>

<script>
  // An early year whose page is built only after its first approved contribution
  // (links from the contribute form, the profile or the recent feed).
  import { approvedForEdition, forEdition } from '../lib/contrib';
  import { t } from '../lib/i18n';
  import { stripLocale, url } from '../lib/paths';
  import { editionFromPath } from '../lib/timeline';
  import { renderFacts, renderMemories, renderUploads } from '../scripts/edicion';

  const box = document.getElementById('no-encontrada')!;
  const ed = editionFromPath(stripLocale(location.pathname), box.dataset.base ?? '/');
  if (ed) {
    const festival = t(`festivales.${ed.festival}`);
    const h = document.createElement('h1');
    h.textContent = t('no_encontrada.edicion_titulo', { festival, year: ed.year });
    const p = document.createElement('p');
    p.textContent = t('no_encontrada.edicion_texto');
    const links = document.createElement('p');
    const a1 = Object.assign(document.createElement('a'), { href: url(`${ed.festival}/`), textContent: t('no_encontrada.ver_festival', { festival }) });
    const a2 = Object.assign(document.createElement('a'), { href: url(`contribuir?f=${ed.festival}&y=${ed.year}`), textContent: t('no_encontrada.contribuir', { year: ed.year }), className: 'btn' });
    links.append(a2, ' ', a1);
    box.replaceChildren(h, p, links);

    // Already approved but not yet built into a page (that waits for the next
    // export): show what is approved now, straight from the public view.
    void approvedForEdition(ed.festival, ed.year).then(({ data }) => {
      if (!data.length) return;
      h.textContent = t('no_encontrada.aprobado_titulo', { festival, year: ed.year });
      p.textContent = t('no_encontrada.aprobado_texto');
      const sections: [string, (m: HTMLElement) => void][] = [
        ['edicion.hechos_titulo', (m) => renderFacts(m, forEdition(data, ed.festival, ed.year, 'fact'))],
        ['edicion.recuerdos_titulo', (m) => renderMemories(m, forEdition(data, ed.festival, ed.year, 'memory'))],
        ['edicion.aportes_aprobados', (m) => {
          renderUploads(m, forEdition(data, ed.festival, ed.year, 'upload'), false);
          m.querySelector('h3')?.remove(); // the section's h2 already says it
        }],
      ];
      for (const [title, render] of sections) {
        const mount = document.createElement('div');
        render(mount);
        if (!mount.childNodes.length) continue;
        const sec = document.createElement('section');
        sec.className = 'section';
        const h2 = document.createElement('h2');
        h2.textContent = t(title);
        sec.append(h2, mount);
        box.append(sec);
      }
    });
  }
</script>
