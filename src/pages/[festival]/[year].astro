---
import Base from '../../layouts/Base.astro';
import EmptySlot from '../../components/EmptySlot.astro';
import ItemCard from '../../components/ItemCard.astro';
import Mount from '../../components/Mount.astro';
import VideoList from '../../components/VideoList.astro';
import Transcripcion from '../../components/Transcripcion.astro';
import { transcriptionDoc } from '../../lib/transcripciones';
import { PUBLIC_WINNERS, winnersDoc } from '../../lib/ganadores';
import type { DocText } from '../../lib/docmd';
import { editionCatalogState, editionCover, editionItems, editionState, festivals, yearRange } from '../../lib/catalog';
import { contentLang, formatList, intlLocales, t, tAround } from '../../lib/i18n';
import { url } from '../../lib/paths';
import { byTitle, CATEGORY_ORDER, docCount, stateLabel } from '../../lib/site';
import type { FestivalSlug } from '../../lib/types';
import approvedRaw from '../../../data/approved/contributions.json';
import editionsStatic from '../../../data/approved/editions.json';
import { byLine, factDisplay, factInOriginal, forEdition, jsonForScript, sortFacts, sourceLine, type Contribution } from '../../lib/contrib';
import { mediaUrl, uploadMedia } from '../../lib/uploads';
import { absUrl, breadcrumbJsonLd, editionDescription, editionFacts, editionJsonLd, ldGraph } from '../../lib/seo';
import { editionVideos } from '../../lib/videos-data';

export function getStaticPaths() {
  return festivals().flatMap((f) => {
    const [a, b] = yearRange(f.slug);
    return Array.from({ length: b - a + 1 }, (_, k) => ({ params: { festival: f.slug, year: String(a + k) } }));
  });
}

const slug = Astro.params.festival as FestivalSlug;
const year = Number(Astro.params.year);
const fest = festivals().find((f) => f.slug === slug)!;
const [first, last] = yearRange(slug);
const list = editionItems(slug, year);
const state = editionState(slug, year);
const cover = editionCover(slug, year);
const videos = editionVideos(slug, year);
const sections = CATEGORY_ORDER.map((c) => ({ c, items: list.filter((i) => i.category === c).sort(byTitle) }));
// Programa always shows (with its slot when incomplete); other empty sections are hidden (live corrections may fill them) and named in one slot.
const missing = sections.filter((s) => s.c !== 'programa' && s.items.length === 0).map((s) => t(`categorias.${s.c}`));
// Approved facts and memories from the last export, baked in for search engines; edicion.ts merges live rows.
const approved = (approvedRaw as Contribution[]).filter((c) => c.festival === slug && c.year === year && ['fact', 'memory', 'upload', 'transcription'].includes(c.type))
  .map((c) => {
    const { storage_path: _private, ...payload } = c.payload ?? {}; // never publish upload paths
    return { ...c, payload };
  });
// Document titles inside translated sentences keep their own language (WCAG 3.1.2).
const lang = contentLang();
const trVer = tAround('edicion.transcripcion_ver', 'titulo');
const ganVer = tAround('edicion.ganadores_ver', 'titulo');
const trAporte = tAround('edicion.transcripcion_aporte', 'titulo');
const fuenteAround = tAround('edicion.fuente', 'fuente');
const facts = sortFacts(forEdition(approved, slug, year, 'fact')).map((c) => ({ ...factDisplay(c), lang: factInOriginal(c) ? contentLang() : undefined, by: byLine(c), fuente: sourceLine(c), fuenteText: String(c.payload?.fuente ?? '').trim() }));
const memories = forEdition(approved, slug, year, 'memory').map((c) => ({ text: String(c.payload?.text ?? ''), by: byLine(c) }));
// Approved uploads with their low-res derivatives (media bucket); same markup edicion.ts renders live.
const mediaBase = import.meta.env.PUBLIC_SUPABASE_URL;
const uploads = forEdition(approved, slug, year, 'upload').map((c) => {
  const m = uploadMedia(c);
  const pages = (m?.pages ?? []).map((p) => mediaUrl(mediaBase, p)).filter((u): u is string => Boolean(u));
  const thumb = m?.thumb ? mediaUrl(mediaBase, m.thumb) : null;
  const category = String(c.payload?.category ?? '');
  return {
    category,
    desc: String(c.payload?.description ?? '') || t('edicion.aporte_sin_descripcion'),
    own: Boolean(c.payload?.description),
    by: byLine(c),
    thumb: thumb ?? pages[0] ?? null,
    href: pages[0] ?? thumb,
    pages,
    group: `aporte-${c.id}`,
  };
});
// For search engines and bots: what this edition is, from the catalog and approved facts.
const editionStatus = (editionsStatic as { festival: string; year: number; status: 'held' | 'not_held' | 'unknown' }[])
  .find((e) => e.festival === slug && e.year === year)?.status ?? null;
const known = editionFacts(approved as Contribution[], slug, year, editionStatus);
const seoDescription = editionDescription(fest.name, year, state, known, list.length + uploads.length);
const seoLd = ldGraph(
  editionJsonLd({ name: fest.name, year, url: absUrl(url(`${slug}/${year}/`)), image: cover ? absUrl(cover.page) : null, facts: known }),
  // The same crumbs as the visible <nav class="crumbs"> below.
  breadcrumbJsonLd([{ name: t('nav.inicio'), url: absUrl(url('/')) }, { name: fest.name, url: absUrl(url(`${slug}/`)) }, { name: String(year) }]),
);
// Standardized transcriptions, folded under their own section (programa, programa del día),
// and approved contributor transcriptions under Programa (edicion.ts merges live rows).
// A document spanning several images is listed once, under its first image's title.
const onePerDoc = (items: typeof list, docOf: (id: string) => DocText | null) => {
  const seen = new Set<string>();
  return items.sort(byTitle).flatMap((i) => {
    const d = docOf(i.id);
    if (!d || seen.has(d.id)) return [];
    seen.add(d.id);
    return [{ item: i, text: d.text, images: d.items.length, doc: d.id }];
  });
};
const transcribedIn = (c: string) => onePerDoc(list.filter((i) => i.category === c && !i.restricted), transcriptionDoc);
// Published winners (Chubut, Trevelin): folded under Resultados; the documents stay restricted.
const winners = PUBLIC_WINNERS.includes(slug) ? onePerDoc(list.filter((i) => i.category === 'resultados'), winnersDoc) : [];
const itemTitles = Object.fromEntries(list.filter((i) => !i.restricted).map((i) => [i.id, i.title]));
const contributedTr = forEdition(approved, slug, year, 'transcription').filter((c) => c.item_id && itemTitles[c.item_id]);
const contribUrl = (tab: string) => url(`contribuir?f=${slug}&y=${year}&tab=${tab}`);
const missingList = formatList(missing.map((m) => m.toLocaleLowerCase(intlLocales())));
---
<Base title={`${fest.name} ${year}`} festival={slug} year={year} description={seoDescription} image={cover?.page ?? null} jsonLd={seoLd} markdown={`${slug}/${year}.md`} searchable>
  <meta data-pagefind-filter="eisteddfod[content]" content={fest.name} />
  <meta data-pagefind-filter="decada[content]" content={`${Math.floor(year / 10) * 10}`} />
  <nav class="crumbs" aria-label={t('comun.miga')} data-pagefind-ignore="all">
    <ol>
      <li><a href={url('/')}>{t('nav.inicio')}</a></li>
      <li><a href={url(`${slug}/`)}>{fest.name}</a></li>
      <li aria-current="page">{year}</li>
    </ol>
  </nav>

  <header class={cover ? 'cover con-tapa' : 'cover'}>
    {cover && (
      <a class="tapa-link" href={cover.page} data-lb="tapa">
        <img class="tapa" src={cover.page} alt={t('edicion.tapa_alt', { festival: fest.name, year })} decoding="async" />
      </a>
    )}
    <h1><span class="fest">{fest.name}</span> <span class="year">{year}</span></h1>
    <p class="state">
      <span class={`badge-state st-${state}`} data-festival={slug} data-year={year} data-state={state} data-cat-state={editionCatalogState(slug, year)} data-status={editionStatus === 'held' ? 'held' : undefined}>{stateLabel(state, editionStatus)}</span>
      {list.length > 0 && <span class="muted"> {docCount(list.length)}</span>}
    </p>
    <div class="cover-actions">
      <a class="btn" href="#aportar" data-contribuir data-festival={slug} data-year={year}>{t('edicion.contribuir')}</a>
    </div>
  </header>

  <section class="section island-section" aria-labelledby="hechos-t">
    <h2 id="hechos-t">{t('edicion.hechos_titulo')}</h2>
    <Mount id="hechos" festival={slug} year={year}>{facts.length > 0 && (
      <dl class="hechos">
        {facts.map((f) => <div><dt>{f.label}</dt><dd><span lang={f.lang}>{f.value}</span>{f.by && <> <span class="muted small">{f.by}</span></>}{f.fuente && <span class="muted small fuente">{lang ? <>{fuenteAround[0]}<span lang={lang}>{f.fuenteText}</span>{fuenteAround[1]}</> : f.fuente}</span>}</dd></div>)}
      </dl>
    )}</Mount>
  </section>

  {sections.map(({ c, items }) => (
    <section class="section" aria-labelledby={`cat-${c}`} data-cat-section={c} hidden={c !== 'programa' && items.length === 0}>
      <h2 id={`cat-${c}`}>{t(`categorias.${c}`)}</h2>
      <ul class="cards" data-scope-festival={slug} data-scope-year={year} data-scope-category={c} hidden={items.length === 0}>
        {items.map((item) => <ItemCard item={item} />)}
      </ul>
      {transcribedIn(c).length > 0 && (
        <div class="transcripciones">
          {transcribedIn(c).map(({ item, text, doc }) => (
            <details class="tr-detalle">
              <summary>{trVer[0]}{lang ? <span lang={lang}>{item.title}</span> : item.title}{trVer[1]}</summary>
              <p class="muted small">{t('item.transcripcion_ayuda')} <a href={url(`item/${item.id}/`)}>{t('edicion.transcripcion_documento')}</a></p>
              <Transcripcion text={text} doc={doc} />
            </details>
          ))}
        </div>
      )}
      {c === 'resultados' && winners.length > 0 && (
        <div class="transcripciones ganadores">
          {winners.map(({ item, text, doc }) => (
            <details class="tr-detalle">
              <summary>{ganVer[0]}{lang ? <span lang={lang}>{item.title}</span> : item.title}{ganVer[1]}</summary>
              <p class="muted small">{t('edicion.ganadores_ayuda')}</p>
              <Transcripcion text={text} doc={doc} />
            </details>
          ))}
        </div>
      )}
      {c === 'programa' && (
        <Mount id="transcripciones" festival={slug} year={year} class="transcripciones" titles={JSON.stringify(itemTitles)}>{contributedTr.map((tr) => (
          <details class="tr-detalle">
            <summary>{trAporte[0]}{lang ? <span lang={lang}>{itemTitles[tr.item_id!]}</span> : itemTitles[tr.item_id!]}{trAporte[1]}{byLine(tr) && <> <span class="muted small">{byLine(tr)}</span></>}</summary>
            <p class="small"><a href={url(`item/${tr.item_id}/`)}>{t('edicion.transcripcion_documento')}</a></p>
            <blockquote class="tr-aporte" lang={contentLang()}>{String(tr.payload?.text ?? '')}</blockquote>
          </details>
        ))}</Mount>
      )}
      {c === 'programa' && state !== 'full' && <div data-falta-programa data-festival={slug} data-year={year}><EmptySlot message={t('edicion.falta_programa')} /></div>}
    </section>
  ))}

  {missing.length > 0 && (
    <section class="section" aria-label={t('edicion.otras_secciones')} data-pagefind-ignore="all">
      <EmptySlot message={t('edicion.faltan_secciones', { lista: missingList })} />
    </section>
  )}

  <VideoList videos={videos} festival={slug} year={year} />

  <section class="section island-section" aria-labelledby="recuerdos-t">
    <h2 id="recuerdos-t">{t('edicion.recuerdos_titulo')}</h2>
    <Mount id="recuerdos" festival={slug} year={year}>{memories.length > 0 && (
      <ul class="recuerdos">
        {memories.map((m) => <li><blockquote lang={contentLang()}>{m.text}</blockquote>{m.by && <p class="muted small">{m.by}</p>}</li>)}
      </ul>
    )}</Mount>
  </section>

  <section class="section" id="aportar" aria-labelledby="aportes-t" data-pagefind-ignore="all">
    <h2 id="aportes-t">{t('edicion.aportes_titulo')}</h2>
    <p class="measure">{t('edicion.aportes_ayuda')}</p>
    <p class="aportes-acciones">
      <a class="btn" href={contribUrl('subir')}>{t('edicion.subir')}</a>
      <a class="btn btn-quiet" href={contribUrl('datos')}>{t('edicion.datos')}</a>
      <a class="btn btn-quiet" href={contribUrl('recuerdo')}>{t('edicion.recuerdo')}</a>
    </p>
    <Mount id="aportes" festival={slug} year={year}>{uploads.length > 0 && (
      <div class="aportes-live">
        <h3 class="small">{t('edicion.aportes_aprobados')}</h3>
        <ul class="aportes-lista">
          {uploads.map((u) => (
            <li class="aporte">
              {u.thumb && <a class="aporte-thumb" href={u.href} data-lb={u.group}><img src={u.thumb} alt={t('item.miniatura_alt', { titulo: u.desc })} loading="lazy" decoding="async" /></a>}
              <div class="aporte-texto">
                {u.category && <><span class="badge">{t(`categorias.${u.category}`)}</span> </>}<span lang={u.own ? contentLang() : undefined}>{u.desc}</span>{u.by && <> <span class="muted small">{u.by}</span></>}
                {u.pages.length > 1 && (
                  <p class="aporte-paginas small">{t('item.paginas', { n: u.pages.length })}:{u.pages.map((p, i) => <> <a href={p} data-lb={u.group} aria-label={t('item.ampliar', { n: i + 1 })}>{i + 1}</a></>)}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}</Mount>
    <script type="application/json" id="aprobados-data" set:html={jsonForScript(approved)}></script>
  </section>

  <nav class="pager" aria-label={t('edicion.todas')}>
    {year > first ? <a href={url(`${slug}/${year - 1}/`)}>{t('edicion.anterior', { year: year - 1 })}</a> : <span></span>}
    <a href={url(`${slug}/`)}>{t('edicion.todas')}</a>
    {year < last ? <a href={url(`${slug}/${year + 1}/`)}>{t('edicion.siguiente', { year: year + 1 })}</a> : <span></span>}
  </nav>
</Base>

<script>
  import '../../scripts/edicion.ts';
  import '../../scripts/live-videos.ts';
  import '../../scripts/informar.ts';
  import '../../scripts/reproductor.ts';
  import '../../scripts/live-transcripciones.ts';
</script>
