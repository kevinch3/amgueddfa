---
import Base from '../layouts/Base.astro';
import FactEditor from '../components/FactEditor.astro';
import approvedStatic from '../../data/approved/contributions.json';
import { editionKeys } from '../lib/admin';
import { allItems, items } from '../lib/catalog';
import { FESTIVALS, jsonForScript } from '../lib/contrib';
import { t } from '../lib/i18n';

const TABS = ['cola', 'cargar', 'restringidos', 'usuarios', 'estadisticas'] as const;
const KINDS = ['upload', 'fact', 'tag', 'transcription', 'memory', 'report', 'note', 'video_text'] as const;

// Precomputed at build time so the admin bundle does not carry the whole catalog.
const data = {
  catalog: editionKeys(items()),
  approved: (approvedStatic as { type: string; festival: string | null; year: number | null; payload: Record<string, unknown> }[])
    .filter((c) => c.type === 'upload')
    .map((c) => ({ type: c.type, festival: c.festival, year: c.year, payload: { category: c.payload?.category ?? null } })),
  restricted: items()
    .filter((i) => i.restricted)
    .map((i) => ({ id: i.id, title: i.title, festival: i.festival, year: i.year, category: i.category, thumb: i.thumb, page_paths: i.page_paths })),
  titles: Object.fromEntries(allItems().map((i) => [i.id, i.title])),
};
---
<Base title={t('admin.titulo')} noindex analytics={false}>
  <section class="admin">
    <h1>{t('admin.titulo')}</h1>
    <div id="admin-gate" aria-live="polite"><p class="muted">{t('admin.cargando')}</p></div>

    <div id="admin-body" hidden>
      <div class="tabs" role="tablist" aria-label={t('admin.pestanas')}>
        {TABS.map((k, i) => (
          <button type="button" role="tab" id={`atab-${k}`} aria-controls={`apanel-${k}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? '0' : '-1'} data-tab={k}>
            {t(`admin.tabs.${k}`)}
          </button>
        ))}
      </div>

      <section id="apanel-cola" role="tabpanel" aria-labelledby="atab-cola">
        <div class="campo">
          <label for="a-tipo">{t('admin.filtro_tipo')}</label>
          <select id="a-tipo">
            <option value="">{t('admin.todos')}</option>
            {KINDS.map((k) => <option value={k}>{t(`admin.tipos.${k}`)}</option>)}
          </select>
        </div>
        <p class="contrib-msg" id="a-cola-msg" role="alert" hidden></p>
        <ol id="a-cola" class="admin-list"></ol>
      </section>

      <section id="apanel-cargar" role="tabpanel" aria-labelledby="atab-cargar" hidden>
        <p class="measure">{t('admin.cargar_ayuda')}</p>
        <form id="a-cargar" class="contrib-form" novalidate>
          <div class="cargar-edicion">
            <div class="campo">
              <label for="a-festival">{t('contrib.festival_label')}</label>
              <select id="a-festival">
                <option value="">{t('contrib.elegir')}</option>
                {FESTIVALS.map((f) => <option value={f}>{t(`festivales.${f}`)}</option>)}
              </select>
            </div>
            <div class="campo">
              <label for="a-year">{t('contrib.ano_label')}</label>
              <input id="a-year" type="number" inputmode="numeric" min="1865" max={new Date().getFullYear()} step="1" />
            </div>
            <div class="campo">
              <label for="a-acreditar">{t('admin.acreditar')}</label>
              <select id="a-acreditar"></select>
            </div>
          </div>
          <p class="contrib-msg" id="a-cargar-msg" role="alert" hidden></p>
          <FactEditor prefix="a" />
          <button class="btn" type="submit" id="a-publicar">{t('admin.publicar')}</button>
        </form>
      </section>

      <section id="apanel-restringidos" role="tabpanel" aria-labelledby="atab-restringidos" hidden>
        <p class="contrib-msg" id="a-restr-msg" role="alert" hidden></p>
        <ul id="a-restr" class="admin-list"></ul>
      </section>

      <section id="apanel-usuarios" role="tabpanel" aria-labelledby="atab-usuarios" hidden>
        <form id="a-buscar" class="admin-search" novalidate>
          <div class="campo">
            <label for="a-q">{t('admin.buscar_label')}</label>
            <input id="a-q" type="search" maxlength="30" autocomplete="off" />
          </div>
          <button class="btn" type="submit">{t('admin.buscar')}</button>
        </form>
        <p class="contrib-msg" id="a-users-msg" role="alert" hidden></p>
        <ul id="a-users" class="admin-list"></ul>
      </section>

      <section id="apanel-estadisticas" role="tabpanel" aria-labelledby="atab-estadisticas" hidden>
        <div id="a-stats" aria-live="polite"></div>
      </section>
    </div>
  </section>
  <script type="application/json" id="admin-data" set:html={jsonForScript(data)} />
</Base>

<script>
  import '../scripts/admin.ts';
</script>

<style is:global>
  .admin .tabs { display: flex; gap: 0.25rem; border-bottom: 2px solid var(--red); margin-bottom: 1rem; flex-wrap: wrap; }
  .admin .tabs [role='tab'] {
    font: 600 1.05rem/1.2 var(--sans); padding: 0.65rem 1.1rem; min-height: 44px; border: 1px solid var(--rule); border-bottom: 0;
    border-radius: 4px 4px 0 0; background: var(--paper); color: var(--ink); cursor: pointer;
  }
  .admin .tabs [role='tab'][aria-selected='true'] { background: var(--red); border-color: var(--red); color: var(--paper-hi); }
  .admin .tabs [role='tab']:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .admin [role='tabpanel'][hidden], #admin-body[hidden] { display: none; }
  .admin .stats-bars { display: flex; align-items: flex-end; gap: 1px; height: 6rem; border-bottom: 1px solid var(--ink-soft); margin: 0.5rem 0 1rem; }
  .admin .stats-bar { flex: 1 1 0; min-width: 1px; height: max(var(--h), 1px); background: var(--red); }
  .admin .stats-grid-wrap { overflow-x: auto; max-width: 100%; }
  .admin .stats-grid { border-collapse: collapse; font-size: 0.75rem; font-variant-numeric: tabular-nums; }
  .admin .stats-grid th, .admin .stats-grid td { padding: 0.15rem 0.25rem; text-align: center; min-width: 1.4rem; }
  .admin .stats-grid td { background: color-mix(in srgb, var(--red) var(--a), transparent); border: 1px solid color-mix(in srgb, var(--red) 15%, transparent); }
  .admin-list { list-style: none; padding: 0; margin: 1rem 0; display: grid; gap: 1rem; }
  .admin-card { background: var(--paper-hi); border: 1px solid var(--rule); padding: 1rem 1.1rem; }
  .admin-card h2 { font-size: 1.1rem; margin: 0 0 0.4rem; display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
  .admin-card pre { white-space: pre-wrap; word-break: break-word; font-size: 0.9rem; background: var(--paper); padding: 0.6rem; border: 1px solid var(--rule); }
  .admin-card textarea { width: 100%; font-family: ui-monospace, monospace; }
  .admin-card .acciones { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
  .admin-card .btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .admin-preview img { max-width: 100%; max-height: 28rem; border: 1px solid var(--rule); }
  .admin-search { display: flex; gap: 0.75rem; align-items: end; flex-wrap: wrap; }
  /* The search box matches the button's height (.btn is 48px). */
  .admin-search .campo input[type='search'] { min-height: 48px; box-sizing: border-box; }
  .admin-search .campo { margin: 0; }
  .admin-thumb { width: 64px; height: auto; border: 1px solid var(--rule); }
  .admin-informe blockquote { margin: 0.25rem 0 0.75rem; padding: 0.5rem 0.8rem; background: var(--paper); border-left: 4px solid var(--gold); white-space: pre-line; overflow-wrap: anywhere; }
  .admin-video { display: flex; gap: 0.6rem; align-items: center; margin-bottom: 0.5rem; }
  .admin-video img { width: 120px; height: auto; flex: none; border: 1px solid var(--rule); }
  .cargar-edicion { display: flex; flex-wrap: wrap; gap: 0 1rem; }
  #a-acreditar { min-width: 14rem; }
  .admin-grupo { list-style: none; border: 2px solid var(--gold); border-radius: 6px; padding: 0.75rem; margin-bottom: 1rem; }
  .admin-grupo-head { margin-bottom: 0.5rem; }
  .admin-grupo .admin-list { padding: 0; }
</style>
