---
import Base from '../layouts/Base.astro';
import FactEditor from '../components/FactEditor.astro';
import { ALCANCES, CATEGORIES, FESTIVALS, MIME_EXT, TEXT_MAX } from '../lib/contrib';
import { festivals, yearRange } from '../lib/catalog';
import { t } from '../lib/i18n';
import { url } from '../lib/paths';

const TABS = ['subir', 'datos', 'recuerdo'] as const;
const thisYear = new Date().getFullYear();
// First year with a built edition page, per festival: the back link hides for earlier years.
const firsts = Object.fromEntries(festivals().map((f) => [f.slug, yearRange(f.slug)[0]]));
---
<Base title={t('contrib.titulo')} noindex>
  <section class="contrib">
    <h1>{t('contrib.titulo')}</h1>
    <p class="lead measure">{t('contrib.intro')}</p>
    <p class="measure">{t('contrib.licencia')} <a href={url('objetivos#licencias')}>{t('contrib.licencia_enlace')}</a>{t('comun.punto')}</p>
    <noscript><p class="contrib-msg">{t('contrib.sin_js')}</p></noscript>

    <section id="contrib-pasos" class="pasos" aria-labelledby="pasos-titulo" hidden>
      <h2 id="pasos-titulo">{t('contrib.pasos.titulo')}</h2>
      <ol>
        <li>
          <svg class="paso-dibujo" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <circle class="fondo" cx="32" cy="32" r="30" />
            <rect class="trazo" x="13" y="21" width="34" height="24" rx="3" />
            <path class="trazo" d="M14 23l16 12 16-12" />
            <circle class="sello" cx="47" cy="20" r="8" />
            <path class="tilde" d="M43.5 20.2l2.4 2.4 4.6-5" />
          </svg>
          <h3>{t('contrib.pasos.p1_t')}</h3>
          <p>{t('contrib.pasos.p1')}</p>
        </li>
        <li>
          <svg class="paso-dibujo" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <circle class="fondo" cx="32" cy="32" r="30" />
            <path class="trazo" d="M18 12h20l8 8v30H18z" />
            <path class="trazo" d="M38 12v8h8" />
            <path class="linea" d="M23 27h17M23 33h17M23 39h11" />
            <circle class="sello" cx="45" cy="45" r="8" />
            <path class="tilde" d="M45 41v8M41 45h8" />
          </svg>
          <h3>{t('contrib.pasos.p2_t')}</h3>
          <p>{t('contrib.pasos.p2')}</p>
        </li>
        <li>
          <svg class="paso-dibujo" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <circle class="fondo" cx="32" cy="32" r="30" />
            <g transform="translate(16.5 11) scale(0.97)">
              <path class="trazo" d="M7 23V11a9 9 0 0 1 18 0v12" />
              <path class="trazo" d="M4 23h24l-1.5 4h-21z" />
              <path class="trazo" d="M7 27v11M25 27v11M7 33h18" />
            </g>
            <circle class="sello" cx="47" cy="20" r="8" />
            <path class="tilde" d="M47 15.2l1.5 3.1 3.4.5-2.45 2.4.58 3.4L47 23l-3.03 1.6.58-3.4-2.45-2.4 3.4-.5z" />
          </svg>
          <h3>{t('contrib.pasos.p3_t')}</h3>
          <p>{t('contrib.pasos.p3')}</p>
        </li>
      </ol>
    </section>

    <div id="contrib-gate" aria-live="polite"><p class="muted">{t('contrib.cargando')}</p></div>

    <div id="contrib-body" hidden>
      <fieldset class="contrib-edicion">
        <legend>{t('contrib.elegir_edicion')}</legend>
        <div class="campo">
          <label for="c-festival">{t('contrib.festival_label')}</label>
          <select id="c-festival" name="festival" required>
            <option value="">{t('contrib.elegir')}</option>
            {FESTIVALS.map((f) => <option value={f}>{t(`festivales.${f}`)}</option>)}
          </select>
        </div>
        <div class="campo">
          <label for="c-year">{t('contrib.ano_label')}</label>
          <input id="c-year" name="year" type="number" inputmode="numeric" min="1865" max={thisYear} step="1" required />
        </div>
        <p class="muted small"><a id="c-volver" href="#" hidden data-firsts={JSON.stringify(firsts)}>{t('contrib.volver_edicion')}</a></p>
      </fieldset>

      <div class="tabs" role="tablist" aria-label={t('contrib.pestanas')}>
        {TABS.map((k, i) => (
          <button type="button" role="tab" id={`tab-${k}`} aria-controls={`panel-${k}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? '0' : '-1'} data-tab={k}>
            {t(`contrib.tabs.${k}`)}
          </button>
        ))}
      </div>

      <p class="contrib-msg" id="c-msg" role="alert" hidden></p>
      <div class="contrib-ok" id="c-ok" role="status" hidden>
        <p><span class="badge" id="c-ok-badge">{t('contrib.pendiente')}</span> <span id="c-ok-text">{t('contrib.gracias')}</span> <a id="c-ok-ver" hidden>{t('contrib.ver_edicion')}</a></p>
        <p><button type="button" class="btn btn-quiet" id="c-otro">{t('contrib.otro')}</button></p>
      </div>

      <form id="panel-subir" role="tabpanel" aria-labelledby="tab-subir" data-kind="upload" class="contrib-form" novalidate>
        <p class="measure">{t('contrib.subir_ayuda')}</p>
        <div class="campo">
          <label for="c-file">{t('contrib.archivo_label')}</label>
          <input id="c-file" name="file" type="file" accept={Object.keys(MIME_EXT).join(',')} required />
        </div>
        <div class="campo">
          <label for="c-category">{t('contrib.categoria_label')}</label>
          <select id="c-category" name="category" required>
            <option value="">{t('contrib.elegir')}</option>
            {CATEGORIES.map((c) => <option value={c}>{t(`categorias.${c}`)}</option>)}
          </select>
        </div>
        <fieldset id="c-alcance" class="campo" hidden>
          <legend>{t('contrib.alcance_label')}</legend>
          {ALCANCES.map((a) => (
            <label class="opt"><input type="radio" name="alcance" value={a} /> {t(`contrib.alcances.${a}`)}</label>
          ))}
        </fieldset>
        <div class="campo">
          <label for="c-description">{t('contrib.descripcion_label')}</label>
          <textarea id="c-description" name="description" rows="3" maxlength="500"></textarea>
        </div>
        <p class="muted small">{t('contrib.declaracion')} <a href={url('derechos#aportes')}>{t('contrib.declaracion_enlace')}</a>{t('comun.punto')}</p>
        <button class="btn" type="submit">{t('contrib.enviar')}</button>
      </form>

      <form id="panel-datos" role="tabpanel" aria-labelledby="tab-datos" data-kind="fact" class="contrib-form" novalidate hidden
        toolname="add_edition_fact"
        tooldescription="Fills in one fact about the eisteddfod edition chosen on this page (date, venue, presenters, Chair or Crown winner, whether it was held, or a competition) with its source. The person reviews it and presses Send; it is published after the archive team approves it.">
        <p class="measure">{t('contrib.datos_ayuda')}</p>
        <FactEditor prefix="c" />
        <p class="muted small">{t('contrib.declaracion')} <a href={url('derechos#aportes')}>{t('contrib.declaracion_enlace')}</a>{t('comun.punto')}</p>
        <button class="btn" type="submit">{t('contrib.enviar')}</button>
      </form>

      <form id="panel-recuerdo" role="tabpanel" aria-labelledby="tab-recuerdo" data-kind="memory" class="contrib-form" novalidate hidden
        toolname="share_memory"
        tooldescription="Fills in a personal memory of the eisteddfod edition chosen on this page, in the person's own words. The person reviews it and presses Send; it is published after the archive team approves it.">
        <p class="measure">{t('contrib.recuerdo_ayuda')}</p>
        <div class="campo">
          <label for="c-text">{t('contrib.recuerdo_label')}</label>
          <textarea id="c-text" name="text" rows="8" maxlength={TEXT_MAX} aria-describedby="c-text-ayuda" toolparamdescription="The memory, in the person's own words (10 to 5000 characters)."></textarea>
          <p class="muted small" id="c-text-ayuda">{t('contrib.caracteres')}</p>
        </div>
        <p class="muted small">{t('contrib.declaracion')} <a href={url('derechos#aportes')}>{t('contrib.declaracion_enlace')}</a>{t('comun.punto')}</p>
        <button class="btn" type="submit">{t('contrib.enviar')}</button>
      </form>
    </div>
  </section>
</Base>

<script>
  import { currentProfile } from '../lib/auth';
  import { submit, submitFacts, type Kind } from '../lib/contrib';
  import { t } from '../lib/i18n';
  import { url } from '../lib/paths';
  import { hasEditionPage } from '../lib/timeline';
  import { mountFactEditor } from '../scripts/fact-editor';
  import type { FestivalSlug } from '../lib/types';
  import { gate, gateMessage } from '../scripts/ui';
  import { agentReply } from '../lib/webmcp';

  const TABS = ['subir', 'datos', 'recuerdo'];
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const params = new URLSearchParams(location.search);
  const itemId = /^[0-9a-f]{12}$/.test(params.get('item') ?? '') ? params.get('item') : null;
  const fest = $<HTMLSelectElement>('c-festival');
  const year = $<HTMLInputElement>('c-year');
  const msg = $<HTMLParagraphElement>('c-msg');
  const ok = $<HTMLDivElement>('c-ok');

  if ([...fest.options].some((o) => o.value === params.get('f'))) fest.value = params.get('f')!;
  if (/^\d{4}$/.test(params.get('y') ?? '')) year.value = params.get('y')!;

  function syncBack() {
    const a = $<HTMLAnchorElement>('c-volver');
    const firsts = JSON.parse(a.dataset.firsts ?? '{}') as Record<string, number>;
    a.hidden = !(fest.value && year.value && hasEditionPage(fest.value, Number(year.value), firsts));
    if (!a.hidden) a.href = url(`${fest.value}/${year.value}/`);
  }
  fest.addEventListener('change', syncBack);
  year.addEventListener('input', syncBack);
  syncBack();

  function say(key: string | null) {
    msg.hidden = !key;
    msg.textContent = key ? t(key) : '';
    // On a phone the message line (above the tabs) is often off-screen when "Enviar" is pressed.
    if (key) msg.scrollIntoView({ block: 'nearest' });
  }

  function select(tab: string, focus = false) {
    if (!TABS.includes(tab)) tab = 'subir';
    for (const k of TABS) {
      const b = $<HTMLButtonElement>(`tab-${k}`);
      const on = k === tab;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
      $(`panel-${k}`).hidden = !on || !ok.hidden;
      if (on && focus) b.focus();
    }
    say(null);
  }
  const current = () => TABS.find((k) => $(`tab-${k}`).getAttribute('aria-selected') === 'true') ?? 'subir';

  for (const k of TABS) {
    const b = $<HTMLButtonElement>(`tab-${k}`);
    b.addEventListener('click', () => select(k));
    b.addEventListener('keydown', (ev) => {
      const i = TABS.indexOf(k);
      const next = ev.key === 'ArrowRight' ? TABS[(i + 1) % TABS.length]
        : ev.key === 'ArrowLeft' ? TABS[(i + TABS.length - 1) % TABS.length]
        : ev.key === 'Home' ? TABS[0] : ev.key === 'End' ? TABS[TABS.length - 1] : null;
      if (next) { ev.preventDefault(); select(next, true); }
    });
  }

  // Subir: a programa needs "¿Qué estás subiendo?" answered; other categories hide it.
  const catSel = $<HTMLSelectElement>('c-category');
  function syncAlcance() {
    const on = catSel.value === 'programa';
    $('c-alcance').hidden = !on;
    for (const r of document.querySelectorAll<HTMLInputElement>('input[name="alcance"]')) r.required = on;
  }
  catSel.addEventListener('change', syncAlcance);
  syncAlcance();

  // Datos: one fact at a time in the editor, several sent together from its list.
  const facts = mountFactEditor($('panel-datos'), { prefix: 'c', yearInput: year, say });

  function inputFor(kind: Kind, form: HTMLFormElement): Record<string, unknown> {
    const fd = new FormData(form);
    const s = (k: string) => String(fd.get(k) ?? '');
    if (kind === 'upload') {
      const f = $<HTMLInputElement>('c-file').files?.[0];
      return { file: f, category: s('category'), alcance: s('alcance'), description: s('description') };
    }
    return { text: s('text') };
  }

  for (const k of TABS) {
    const form = $<HTMLFormElement>(`panel-${k}`);
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      // A form the browser's agent filled (WebMCP): tell it what the page now says.
      agentReply(ev, send().then(() => (ok.hidden ? msg.textContent ?? '' : $('c-ok-text').textContent ?? '')));
    });
    const send = async () => {
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      if (btn.disabled) return;
      say(null);
      const y = Number(year.value);
      if (!fest.value || !Number.isInteger(y) || y < 1865 || y > new Date().getFullYear()) {
        say('contrib.error.edicion');
        (fest.value ? year : fest).focus();
        return;
      }
      const kind = form.dataset.kind as Kind;
      let collected: ReturnType<typeof facts.collect> | null = null;
      if (kind === 'fact') {
        collected = facts.collect();
        if ('error' in collected) return say(collected.error);
      }
      btn.disabled = true;
      btn.textContent = t('contrib.enviando');
      const r: { ok: boolean; key?: string; index?: number } = collected && !('error' in collected)
        ? await submitFacts(fest.value as FestivalSlug, y, collected.facts, collected.fuente)
        : await submit(kind, fest.value as FestivalSlug, y, itemId, inputFor(kind, form));
      btn.disabled = false;
      btn.textContent = t('contrib.enviar');
      if (!r.ok) {
        // A fact from the list: say which one ("Dato 3: …").
        if (r.index !== undefined) {
          msg.hidden = false;
          msg.textContent = t('contrib.dato_n', { n: r.index + 1, error: t(r.key!) });
        } else say(r.key!);
        if (r.key === 'contrib.error.sesion') void start();
        return;
      }
      form.reset();
      facts.reset();
      syncAlcance();
      // Admins' contributions are approved on insert: say so, and link to where it shows.
      const admin = (await currentProfile())?.role === 'admin';
      $('c-ok-badge').textContent = t(admin ? 'contrib.publicado' : 'contrib.pendiente');
      $('c-ok-text').textContent = t(admin ? 'contrib.gracias_admin' : 'contrib.gracias');
      const ver = $<HTMLAnchorElement>('c-ok-ver');
      const firsts = JSON.parse($('c-volver').dataset.firsts ?? '{}') as Record<string, number>;
      ver.hidden = !admin || !hasEditionPage(fest.value, y, firsts);
      if (!ver.hidden) ver.href = url(`${fest.value}/${y}/`);
      ok.hidden = false;
      for (const k2 of TABS) $(`panel-${k2}`).hidden = true;
      $<HTMLButtonElement>('c-otro').focus();
    };
  }

  $('c-otro').addEventListener('click', () => {
    ok.hidden = true;
    select(current(), true);
  });

  async function start() {
    const g = await gate();
    const box = $('contrib-gate');
    if (!g.profile) {
      box.replaceChildren(gateMessage(g.reason, 'contrib.ingresar'));
      // Signed-out visitors see how contributing works (sign in, contribute, review) above the button.
      $('contrib-pasos').hidden = g.reason !== 'signed_out';
      $('contrib-body').hidden = true;
      return;
    }
    box.replaceChildren();
    $('contrib-pasos').hidden = true;
    $('contrib-body').hidden = false;
    select(params.get('tab') ?? 'subir');
  }
  void start();
  document.addEventListener('amg:sesion', () => void start());
</script>

<style>
  .contrib { max-width: 40rem; }
  .contrib-edicion { border: 1px solid var(--rule); padding: 0.75rem 1rem 0.25rem; margin: 1rem 0 1.25rem; display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  .contrib-edicion legend { font: 600 1rem/1.3 var(--sans); padding: 0 0.3rem; }
  .contrib-edicion p { flex-basis: 100%; }
  .tabs { display: flex; gap: 0.25rem; border-bottom: 2px solid var(--red); margin-bottom: 1rem; flex-wrap: wrap; }
  .tabs [role='tab'] {
    font: 600 1.05rem/1.2 var(--sans); padding: 0.65rem 1.1rem; min-height: 44px; border: 1px solid var(--rule); border-bottom: 0;
    border-radius: 4px 4px 0 0; background: var(--paper); color: var(--ink); cursor: pointer;
  }
  .tabs [role='tab'][aria-selected='true'] { background: var(--red); border-color: var(--red); color: var(--paper-hi); }
  .tabs [role='tab']:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .contrib-form[hidden], #contrib-body[hidden] { display: none; }
  .contrib-form .btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .pasos { margin: 1.5rem 0 0.5rem; }
  .pasos[hidden] { display: none; }
  .pasos h2 { font-size: 1.25rem; margin: 0 0 0.75rem; }
  .pasos ol { list-style: none; counter-reset: paso; padding: 0; margin: 0; display: grid; gap: 1.25rem; }
  .pasos li {
    counter-increment: paso; position: relative; display: grid; grid-template-columns: 4rem 1fr; column-gap: 1rem; align-items: start; align-content: start;
    background: var(--paper-hi); border: 1px solid var(--rule); border-radius: 10px; padding: 1rem;
  }
  .pasos h3, .pasos p { grid-column: 2; }
  .pasos .paso-dibujo { grid-column: 1; grid-row: 1 / span 2; width: 4rem; height: 4rem; }
  .pasos h3 { font: 600 1.05rem/1.3 var(--sans); margin: 0.15rem 0 0.25rem; }
  .pasos h3::before { content: counter(paso) '. '; color: var(--red); }
  .pasos p { margin: 0; font-size: 1rem; color: var(--ink-soft); }
  /* the steps are joined by a dotted thread, down on phones and across on wide screens */
  .pasos li + li::before {
    content: ''; position: absolute; left: calc(1rem + 2rem - 1px); top: calc(-1.25rem - 1px); height: 1.25rem;
    border-left: 2px dashed var(--gold);
  }
  .paso-dibujo .fondo { fill: var(--paper); stroke: var(--gold); stroke-width: 2; }
  .paso-dibujo .trazo, .paso-dibujo .linea { fill: none; stroke: var(--red); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .paso-dibujo .trazo { fill: var(--paper-hi); }
  .paso-dibujo .linea { stroke: var(--ink-soft); stroke-width: 2; }
  .paso-dibujo .sello { fill: var(--gold); }
  .paso-dibujo .tilde { fill: none; stroke: var(--ink); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .paso-dibujo path.tilde:last-child[d*='z'] { fill: var(--ink); stroke-width: 0.6; }
  @media (min-width: 46rem) {
    .contrib:has(.pasos:not([hidden])) { max-width: var(--wide); }
    .pasos ol { grid-template-columns: repeat(3, 1fr); }
    .pasos li { grid-template-columns: 1fr; text-align: center; justify-items: center; padding: 1.25rem 1rem; }
    .pasos h3, .pasos p, .pasos .paso-dibujo { grid-column: 1; grid-row: auto; }
    .pasos .paso-dibujo { width: 5rem; height: 5rem; margin-bottom: 0.5rem; }
    .pasos li + li::before { left: calc(-1.25rem - 1px); top: calc(1.25rem + 2.5rem); width: 1.25rem; height: 0; border-left: 0; border-top: 2px dashed var(--gold); }
  }
  .opt { display: inline-flex; align-items: center; gap: 0.4rem; margin-right: 1.25rem; min-height: 44px; font-family: var(--sans); }
</style>
