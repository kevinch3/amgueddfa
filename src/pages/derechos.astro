---
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
import { url } from '../lib/paths';

const c = (k: string) => t(`legal.derechos.${k}`);
---
<Base title={t('legal.titulos.derechos')} description={c('descripcion')}>
  <article class="legal measure">
    <h1>{t('legal.titulos.derechos')}</h1>
    <p class="lead">{c('intro')}</p>

    <h2>{c('alcance_titulo')}</h2>
    <p>{c('alcance_1')}</p>

    <h2>{c('quien_titulo')}</h2>
    <p>{c('quien_1')}</p>

    <h2>{c('pedido_titulo')}</h2>
    <p>{c('pedido_1')}</p>
    <ul>
      <li>{c('pedido_doc')}</li>
      <li>{c('pedido_caracter')}</li>
      <li>{c('pedido_motivo')}</li>
      <li>{c('pedido_contacto')}</li>
    </ul>

    <h2>{c('plazos_titulo')}</h2>
    <p>{c('plazos_1')}</p>

    <h2>{c('contra_titulo')}</h2>
    <p>{c('contra_1')}</p>

    <h2>{c('ley_titulo')}</h2>
    <p>{c('ley_1')}</p>
    <p>{c('ley_2')} <a href="https://docs.github.com/es/site-policy/content-removal-policies/dmca-takedown-policy" rel="noopener">{c('ley_github')}</a>.</p>

    <h2 id="aportes">{c('aportes_titulo')}</h2>
    <p>{c('aportes_1')}</p>
    <p>{c('aportes_2')} <a href={url('objetivos#licencias')}>{c('aportes_objetivos')}</a>.</p>
  </article>
</Base>
