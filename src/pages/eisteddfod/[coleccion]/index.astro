---
import Base from '../../../layouts/Base.astro';
import TimelineRow from '../../../components/TimelineRow.astro';
import { editionCover, editionItems, editionState, festivals, firstMaterialYear, items, thumbUrl, undocumented, yearRange } from '../../../lib/catalog';
import { t } from '../../../lib/i18n';
import { url } from '../../../lib/paths';
import { CATEGORY_ORDER, docCount } from '../../../lib/site';
import { decades } from '../../../lib/timeline';
import type { FestivalSlug } from '../../../lib/types';

export function getStaticPaths() {
  return festivals().map((f) => ({ params: { coleccion: f.slug } }));
}

const slug = Astro.params.coleccion as FestivalSlug;
const fest = festivals().find((f) => f.slug === slug)!;
const [first, last] = yearRange(slug);
function row(y: number) {
  const list = editionItems(slug, y);
  const thumbs = [...list]
    .sort((a, b) => CATEGORY_ORDER.indexOf(a.tipo) - CATEGORY_ORDER.indexOf(b.tipo))
    .map((i) => ({ src: thumbUrl(i), title: i.title }))
    .filter((x) => x.src);
  // The cover identifies the edition, so it leads (once) the year's thumbnails.
  const cover = editionCover(slug, y);
  if (cover) {
    const rest = thumbs.filter((x) => x.src !== cover.thumb);
    thumbs.splice(0, thumbs.length, { src: cover.thumb, title: t('edicion.tapa_alt', { festival: fest.name, year: y }) }, ...rest);
  }
  thumbs.splice(4);
  return { y, state: editionState(slug, y), n: list.length, thumbs };
}
// Newest first; a whole empty decade becomes one collapsed entry.
const groups = decades(first, last, (y) => undocumented(slug, y))
  .reverse()
  .map((d) => ({ ...d, rows: [...d.years].reverse().map(row) }));
const since = firstMaterialYear(slug);
const general = items().filter((i) => i.coleccion === slug && i.fecha.year === null).length;
---
<Base title={fest.name} coleccion={slug} description={since !== null ? `${fest.name}. ${t('festival.desde', { year: since })} ${t('inicio.lema')}` : t('inicio.lema')}>
  <header class="cover">
    <h1>{fest.name}</h1>
    {fest.nameCy !== fest.name && <p class="cy" lang="cy"><em>{fest.nameCy}</em></p>}
    {since !== null && <p class="muted">{t('festival.desde', { year: since })}</p>}
    <p class="antes small">{t('festival.antes', { year: first })} <a href={url(`contribuir?f=${slug}`)} aria-label={t('festival.antes_link_aria', { festival: fest.name })}>{t('festival.antes_link')}</a></p>
    {general > 0 && <p><a href={url(`general/${slug}/`)}>{t('festival.ver_general')}</a> ({docCount(general)})</p>}
  </header>

  <h2>{t('festival.linea_tiempo')}</h2>
  <ul class="legend" aria-label={t('inicio.mapa_leyenda')}>
    <li><span class="swatch st-full"></span>{t('estados.full')}</li>
    <li><span class="swatch st-some"></span>{t('estados.some')}</li>
    <li><span class="swatch st-none"></span>{t('estados.none')}</li>
  </ul>
  <ol class="timeline" reversed>
    {groups.map((g) => g.empty ? (
      <li class="tl-decada">
        <details class="decada-vacia" data-decada-vacia>
          <summary>{t('festival.decada_vacia', { from: g.from, to: g.to })}</summary>
          <ol class="decada-filas" reversed>
            {g.rows.map((r) => <TimelineRow slug={slug} {...r} />)}
          </ol>
        </details>
      </li>
    ) : g.rows.map((r) => <TimelineRow slug={slug} {...r} />))}
  </ol>
</Base>

<script>
  import '../../../scripts/edicion.ts';
</script>
