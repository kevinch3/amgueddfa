---
import Base from '../../layouts/Base.astro';
import ItemCard from '../../components/ItemCard.astro';
import { festivals, items } from '../../lib/catalog';
import { t } from '../../lib/i18n';
import { url } from '../../lib/paths';
import { byTitle } from '../../lib/site';
import type { FestivalSlug } from '../../lib/types';

export function getStaticPaths() {
  return festivals().map((f) => ({ params: { festival: f.slug } }));
}

const slug = Astro.params.festival as FestivalSlug;
const fest = festivals().find((f) => f.slug === slug)!;
const mine = items().filter((i) => i.festival === slug && i.year === null);
const groups = [
  { key: 'generales', list: mine.filter((i) => !i.undated).sort(byTitle) },
  { key: 'sin_fecha', list: mine.filter((i) => i.undated).sort(byTitle) },
];
---
<Base title={t('general.titulo', { festival: fest.name })} festival={slug}>
  <nav class="crumbs" aria-label={t('comun.miga')}>
    <ol>
      <li><a href={url('/')}>{t('nav.inicio')}</a></li>
      <li><a href={url(`${slug}/`)}>{fest.name}</a></li>
      <li aria-current="page">{t('festival.general_titulo')}</li>
    </ol>
  </nav>
  <h1>{t('general.titulo', { festival: fest.name })}</h1>
  {groups.map((g) => (
    <section class="section" aria-labelledby={`g-${g.key}`}>
      <h2 id={`g-${g.key}`}>{t(`general.${g.key}`)}</h2>
      <p class="muted measure">{t(`general.${g.key}_ayuda`)}</p>
      <ul class="cards" data-scope-festival={slug} data-scope-year="none" data-scope-undated={g.key === 'sin_fecha' ? 'true' : 'false'} hidden={g.list.length === 0}>{g.list.map((item) => <ItemCard item={item} />)}</ul>
      <p class="muted" data-scope-empty hidden={g.list.length > 0}>{t('general.vacio')}</p>
    </section>
  ))}
</Base>
