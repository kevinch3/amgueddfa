---
// The museum's front door (#189): amgueddfa.org is widening from the Patagonian
// eisteddfodau to the history of the Welsh outside Wales. Each collection gets a
// card here; the Eisteddfod archive (everything under /eisteddfod/) is the first.
import Base from '../layouts/Base.astro';
import { festivals, firstMaterialYear, items } from '../lib/catalog';
import { t } from '../lib/i18n';
import { url } from '../lib/paths';
import { siteJsonLd } from '../lib/seo';

const fests = festivals();
const since = Math.min(...fests.map((f) => firstMaterialYear(f.slug) ?? Infinity));
---
<Base title={t('hub.titulo')} description={t('hub.lema')} jsonLd={siteJsonLd()}>
  <section class="intro measure">
    <h1>{t('hub.titulo')}</h1>
    <p class="lead">{t('hub.lema')}</p>
  </section>

  <section class="section" aria-labelledby="colecciones-t">
    <h2 id="colecciones-t">{t('hub.colecciones')}</h2>
    <ul class="colecciones">
      <li class="coleccion">
        <h3><a href={url('/')}>{t('hub.eisteddfod_titulo')}</a></h3>
        <p>{t('inicio.lema')}</p>
        <p class="muted">{t('inicio.contador', { docs: items().length, festivales: fests.length, desde: since })}</p>
        <p><a class="btn" href={url('/')}>{t('hub.entrar')}</a></p>
      </li>
    </ul>
    <p class="muted measure">{t('hub.pronto')}</p>
  </section>
</Base>
