---
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
import { url } from '../lib/paths';
---
<Base title={t('auth.titulo')}>
  <section class="auth" data-home={url('/')}>
    <h1>{t('auth.titulo')}</h1>
    <noscript><p class="auth-msg">{t('auth.sin_js')}</p></noscript>

    <p class="auth-msg" id="auth-msg" role="alert" hidden></p>

    <form id="paso-email" class="auth-step" novalidate>
      <p class="lead">{t('auth.intro')}</p>
      <label for="auth-email">{t('auth.email_label')}</label>
      <input id="auth-email" name="email" type="email" inputmode="email" autocomplete="email" required />
      <button class="btn" type="submit" data-idle={t('auth.enviar')} data-busy={t('auth.enviando')}>{t('auth.enviar')}</button>
    </form>

    <form id="paso-codigo" class="auth-step" novalidate hidden>
      <p id="auth-codigo-ayuda" data-tpl={t('auth.codigo_ayuda')}></p>
      <label for="auth-codigo">{t('auth.codigo_label')}</label>
      <input id="auth-codigo" name="codigo" type="text" inputmode="numeric" autocomplete="one-time-code"
        pattern="[0-9 ]*" maxlength="7" required aria-describedby="auth-codigo-ayuda" />
      <button class="btn" type="submit" data-idle={t('auth.verificar')} data-busy={t('auth.verificando')}>{t('auth.verificar')}</button>
      <p class="auth-extra">
        <button class="btn btn-quiet" type="button" id="auth-reenviar">{t('auth.reenviar')}</button>
        <button class="btn btn-quiet" type="button" id="auth-cambiar">{t('auth.cambiar_email')}</button>
      </p>
      <p class="muted" id="auth-espera" data-tpl={t('auth.reenviar_en')} aria-live="polite"></p>
    </form>

    <form id="paso-nombre" class="auth-step" novalidate hidden>
      <h2>{t('auth.nombre_titulo')}</h2>
      <p id="auth-nombre-ayuda">{t('auth.nombre_ayuda')}</p>
      <label for="auth-nombre">{t('auth.nombre_label')}</label>
      <input id="auth-nombre" name="nombre" type="text" autocomplete="nickname" minlength="3" maxlength="30" required
        aria-describedby="auth-nombre-ayuda" />
      <button class="btn" type="submit" data-idle={t('auth.guardar')} data-busy={t('auth.guardando')}>{t('auth.guardar')}</button>
    </form>

    <div id="paso-listo" class="auth-step" hidden>
      <p class="lead" id="auth-listo" data-tpl-listo={t('auth.listo')} data-tpl-ya={t('auth.ya_adentro')}></p>
      <p class="auth-extra">
        <a class="btn" id="auth-volver" href="#" hidden>{t('auth.volver')}</a>
        <a class="btn" id="auth-inicio" href={url('/')}>{t('auth.ir_inicio')}</a>
        <button class="btn btn-quiet" type="button" id="auth-salir">{t('auth.salir')}</button>
      </p>
    </div>
  </section>
</Base>

<script>
  import { canResend, currentProfile, returnPath, sendCode, setDisplayName, signOut, verifyCode, type Result } from '../lib/auth';
  import { url } from '../lib/paths';
  import { t } from '../lib/i18n';
  import { getClient } from '../lib/supabase';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const steps = ['paso-email', 'paso-codigo', 'paso-nombre', 'paso-listo'];
  const msg = $<HTMLParagraphElement>('auth-msg');
  let email = '';
  let lastSentAt = 0;
  let tick: ReturnType<typeof setInterval> | undefined;
  // Where to go back to after signing in (only a page on this site).
  const volver = returnPath(new URLSearchParams(location.search).get('volver'), url('/'));
  if (volver) {
    const a = $<HTMLAnchorElement>('auth-volver');
    a.href = volver;
    a.hidden = false;
    $<HTMLAnchorElement>('auth-inicio').className = 'btn btn-quiet';
  }

  function show(id: string) {
    for (const s of steps) $(s).hidden = s !== id;
    const first = $(id).querySelector<HTMLElement>('input, .btn');
    first?.focus();
  }
  function say(key: string | null) {
    msg.hidden = !key;
    msg.textContent = key ? t(key) : '';
  }
  function busy(form: HTMLElement, on: boolean) {
    const b = form.querySelector<HTMLButtonElement>('button[type=submit]');
    if (!b) return;
    b.disabled = on;
    b.textContent = (on ? b.dataset.busy : b.dataset.idle) ?? '';
  }
  function countdown() {
    const resend = $<HTMLButtonElement>('auth-reenviar');
    const wait = $<HTMLParagraphElement>('auth-espera');
    clearInterval(tick);
    const update = () => {
      const left = Math.ceil((lastSentAt + 60_000 - Date.now()) / 1000);
      const ok = canResend(lastSentAt, Date.now());
      resend.disabled = !ok;
      wait.textContent = ok ? '' : (wait.dataset.tpl ?? '').replace('{s}', String(left));
      if (ok) clearInterval(tick);
    };
    update();
    tick = setInterval(update, 1000);
  }
  function done(name: string, already: boolean) {
    const el = $<HTMLParagraphElement>('auth-listo');
    el.textContent = ((already ? el.dataset.tplYa : el.dataset.tplListo) ?? '').replace('{nombre}', name);
    show('paso-listo');
    document.dispatchEvent(new CustomEvent('amg:sesion'));
  }
  async function afterSignIn(already: boolean) {
    const p = await currentProfile();
    if (p?.display_name) done(p.display_name, already);
    else if (p) show('paso-nombre');
    else if (!already) { say('estado.sin_conexion'); show('paso-codigo'); }
  }
  async function send(form: HTMLElement): Promise<Result> {
    busy(form, true);
    const r = await sendCode(email);
    busy(form, false);
    if (r.ok) {
      lastSentAt = Date.now();
      countdown();
    }
    return r;
  }

  $('paso-email').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const form = ev.currentTarget as HTMLFormElement;
    if (form.querySelector<HTMLButtonElement>('button[type=submit]')?.disabled) return;
    email = $<HTMLInputElement>('auth-email').value;
    say(null);
    const r = await send(form);
    if (!r.ok) return say(r.key);
    const help = $<HTMLParagraphElement>('auth-codigo-ayuda');
    help.textContent = (help.dataset.tpl ?? '').replace('{email}', email.trim());
    $<HTMLInputElement>('auth-codigo').value = '';
    show('paso-codigo');
  });

  $('paso-codigo').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const form = ev.currentTarget as HTMLFormElement;
    if (form.querySelector<HTMLButtonElement>('button[type=submit]')?.disabled) return;
    say(null);
    busy(form, true);
    const r = await verifyCode(email, $<HTMLInputElement>('auth-codigo').value);
    busy(form, false);
    if (!r.ok) return say(r.key);
    await afterSignIn(false);
  });

  $('auth-reenviar').addEventListener('click', async () => {
    if (!canResend(lastSentAt, Date.now())) return;
    say(null);
    const b = $<HTMLButtonElement>('auth-reenviar');
    b.disabled = true;
    const r = await send($('paso-codigo'));
    if (!r.ok) { b.disabled = false; return say(r.key); }
    msg.hidden = false;
    msg.textContent = t('auth.reenviado');
  });

  $('auth-cambiar').addEventListener('click', () => {
    say(null);
    show('paso-email');
  });

  $('paso-nombre').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const form = ev.currentTarget as HTMLFormElement;
    if (form.querySelector<HTMLButtonElement>('button[type=submit]')?.disabled) return;
    say(null);
    const name = $<HTMLInputElement>('auth-nombre').value.trim();
    busy(form, true);
    const r = await setDisplayName(name);
    busy(form, false);
    if (!r.ok) return say(r.key);
    done(name, false);
  });

  $('auth-salir').addEventListener('click', async () => {
    const r = await signOut();
    document.dispatchEvent(new CustomEvent('amg:sesion'));
    if (!r.ok) return say(r.key);
    say(null);
    show('paso-email');
  });

  if (!getClient()) say('estado.sin_conexion');
  else afterSignIn(true);
</script>

<style>
  .auth { max-width: 32rem; }
  .auth-step { display: grid; gap: 0.6rem; margin: 1rem 0; }
  .auth-step[hidden] { display: none; }
  .auth label { font: 600 1rem/1.3 var(--sans); }
  .auth input {
    font: 1.15rem/1.3 var(--sans); padding: 0.6rem 0.75rem; min-height: 48px;
    border: 2px solid var(--rule); border-radius: 4px; background: var(--paper-hi); color: var(--ink);
  }
  .auth input:focus-visible { outline: 3px solid var(--focus); outline-offset: 1px; }
  #auth-codigo { letter-spacing: 0.3em; max-width: 12rem; }
  .auth .btn { justify-self: start; }
  .auth .btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .auth-extra { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.5rem 0 0; }
  .auth-msg { border-left: 4px solid var(--red); background: var(--paper-hi); padding: 0.6rem 0.9rem; font-family: var(--sans); }
</style>
