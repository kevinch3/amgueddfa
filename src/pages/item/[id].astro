---
import Base from '../../layouts/Base.astro';
import Mount from '../../components/Mount.astro';
import Viewer from '../../components/Viewer.astro';
import Transcripcion from '../../components/Transcripcion.astro';
import approvedRaw from '../../../data/approved/contributions.json';
import { byLine, jsonForScript, type Contribution } from '../../lib/contrib';
import { transcriptionDoc } from '../../lib/transcripciones';
import { ocrFor } from '../../lib/ocr';
import { allItems, pageUrls, thumbUrl } from '../../lib/catalog';
import { absUrl, breadcrumbJsonLd, editionFacts, isConfirmedEdition, itemJsonLd, ldGraph } from '../../lib/seo';
import editionsStatic from '../../../data/approved/editions.json';
import { contentLang, intlLocales, t } from '../../lib/i18n';
import { url } from '../../lib/paths';
import { festivalName } from '../../lib/site';
import type { Item } from '../../lib/types';

export function getStaticPaths() {
  // Hidden items (an approved "no corresponde" report) keep their page, with a notice.
  return allItems().map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props as { item: Item };
const fest = festivalName(item.festival);
const hasPages = pageUrls(item).length > 0;
const TABLE_COLS = ['numero', 'categoria', 'idioma', 'descripcion'];
const yearLabel = item.year ?? (item.undated ? t('item.sin_fecha') : t('item.general'));
const yearHref = item.year ? url(`${item.festival}/${item.year}/`) : url(`general/${item.festival}/`);
// For search engines: restricted items never expose an image (thumbUrl is null for them).
const image = thumbUrl(item);
const description = `${[item.title.replace(/[.\s]+$/, ''), `${fest}${item.year ? ` ${item.year}` : ''}`, t(`categorias.${item.category}`)].join(' · ')}.`;
// Restricted documents get no structured data (they are not freely available here).
// "About" the edition's Event only when the archive knows whether it took place (see seo.ts).
const editionStatus = item.year === null ? null : (editionsStatic as { festival: string; year: number; status: 'held' | 'not_held' | 'unknown' }[])
  .find((e) => e.festival === item.festival && e.year === item.year)?.status ?? null;
const editionConfirmed = item.year !== null && isConfirmedEdition(editionFacts(approvedRaw as Contribution[], item.festival, item.year, editionStatus));
const jsonLd = item.restricted ? null : ldGraph(
  itemJsonLd({
    name: item.title, url: absUrl(url(`item/${item.id}/`)), image: image ? absUrl(image) : null,
    editionUrl: item.year ? absUrl(url(`${item.festival}/${item.year}/`)) : null,
    editionName: item.year ? `${fest} ${item.year}` : null, year: item.year, editionConfirmed, rights: item.rights,
  }),
  // The same crumbs as the visible <nav class="crumbs"> below.
  breadcrumbJsonLd([
    { name: t('nav.inicio'), url: absUrl(url('/')) },
    { name: fest, url: absUrl(url(`${item.festival}/`)) },
    { name: String(yearLabel), url: absUrl(yearHref) },
    { name: t(`categorias.${item.category}`) },
  ]),
);
// Standardized transcription (committed) and approved contributor transcriptions (last export; transcripciones.ts merges live rows).
const trDoc = item.restricted ? null : transcriptionDoc(item.id);
const transcription = trDoc?.text ?? null;
// Machine text (scripts/ocr.py), only when there is no transcription and no embedded text.
const ocr = item.restricted || transcription || item.text_excerpt ? null : ocrFor(item.id);
// A transcription shared by several images of one document: link the other images.
const byIdAll = new Map(allItems().map((i) => [i.id, i] as const));
const trSiblings = (trDoc?.items ?? []).filter((x) => x !== item.id).map((x) => byIdAll.get(x)).filter((x) => x && !x.restricted);
const contributed = item.restricted ? [] : (approvedRaw as Contribution[]).filter((c) => c.type === 'transcription' && c.item_id === item.id);
// Approved notes ("Agregar información") from the last export; transcripciones.ts merges live rows.
const notes = item.restricted ? [] : (approvedRaw as Contribution[]).filter((c) => c.type === 'note' && c.item_id === item.id);
// What an admin correction can change (src/lib/tags.ts): live-catalog.ts and admin-item.ts start from it.
const overlayBase = {
  id: item.id, festival: item.festival, year: item.year, undated: item.undated, category: item.category, title: item.title,
  rights: item.rights ?? '', note_public: item.note_public ?? '', no_text: Boolean(item.no_text), hidden: Boolean(item.hidden),
  restricted: item.restricted, year_inferred: item.year_inferred,
};
const retrieved = item.retrieved
  ? new Date(`${item.retrieved}T12:00:00`).toLocaleDateString(intlLocales(), { day: 'numeric', month: 'long', year: 'numeric' })
  : '';
---
<Base title={item.title} festival={item.festival} year={item.year} item={item.id} description={description} image={image} jsonLd={item.hidden ? null : jsonLd} markdown={item.hidden || item.restricted ? null : `item/${item.id}.md`} searchable={!item.hidden && !item.restricted} noindex={Boolean(item.hidden)}>
  <meta data-pagefind-filter="eisteddfod[content]" content={fest} />
  {item.year !== null && <meta data-pagefind-filter="decada[content]" content={`${Math.floor(item.year / 10) * 10}`} />}
  <meta data-pagefind-filter="categoria[content]" content={t(`categorias.${item.category}`)} />
  <nav class="crumbs" aria-label={t('comun.miga')} data-pagefind-ignore="all">
    <ol>
      <li><a href={url('/')}>{t('nav.inicio')}</a></li>
      <li><a href={url(`${item.festival}/`)} data-live="festival">{fest}</a></li>
      <li><a href={yearHref} data-live="year">{yearLabel}</a></li>
      <li data-live="category">{t(`categorias.${item.category}`)}</li>
    </ol>
  </nav>

  <header class="item-head" data-item-page={item.id}>
    <h1 lang={contentLang()}>{item.title}</h1>
    <p class="badges">
      <span class="badge" data-live="category">{t(`categorias.${item.category}`)}</span>
      <span class="badge">{t(`item.tipos.${item.kind}`)}</span>
      {item.pages > 1 && !item.restricted && <span class="badge">{t('item.paginas', { n: item.pages })}</span>}
      {item.year_inferred && <span class="badge" data-live="inferred" title={t('comun.ano_estimado_ayuda')}>{t('comun.ano_estimado')}</span>}
    </p>
  </header>

  <p class="contrib-msg" data-retirado hidden={!item.hidden}>{t('item.retirado')}</p>
  <script type="application/json" id="item-overlay" set:html={jsonForScript(overlayBase)}></script>

  <div class="item-layout">
    <div class="item-main">
      {item.restricted ? (
        <div class="restricted">
          <h2>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5z" /></svg>
            {t('item.restringido')}
          </h2>
          <p>{t('item.restringido_ayuda')}</p>
          <Mount id="liberado" festival={item.festival} year={item.year} item={item.id} pages={item.page_paths.map((p) => p.split('/').pop()).join(' ')} />
        </div>
      ) : hasPages ? (
        <Viewer item={item} />
      ) : item.kind === 'table' && item.table ? (
        <section aria-labelledby="tabla-t">
          <h2 id="tabla-t">{t('item.tabla_titulo')}</h2>
          <p class="muted">{t('item.tabla_ayuda', { n: item.table.length })}</p>
          <div class="tablewrap" tabindex="0" role="region" aria-labelledby="tabla-t">
            <table>
              <thead><tr>{TABLE_COLS.map((c) => <th scope="col">{t(`tabla.${c}`)}</th>)}</tr></thead>
              <tbody>
                {item.table.map((row) => <tr lang={contentLang()}>{TABLE_COLS.map((c) => <td>{String(row[c] ?? '')}</td>)}</tr>)}
              </tbody>
            </table>
          </div>
        </section>
      ) : item.text_excerpt && !transcription ? (
        <section aria-labelledby="texto-t">
          <h2 id="texto-t">{t('item.texto_titulo')}</h2>
          <p class="muted small">{t('item.texto_ayuda')}</p>
          <div class="textcard" lang={contentLang()}>{item.text_excerpt}</div>
        </section>
      ) : transcription || ocr ? null : (
        <p class="textcard">{t('item.sin_vista')}</p>
      )}
      {ocr && (
        <section class="section" aria-labelledby="ocr-t" data-ocr data-pagefind-weight="0.5">
          <details>
            <summary><h2 id="ocr-t">{t('item.ocr_titulo')}</h2></summary>
            <p class="muted small">{t('item.ocr_ayuda')}</p>
            {ocr.pages.map((p) => (
              <div id={`ocr-p${p.n}`}>
                {ocr.pages.length > 1 && <h3 class="small">{t('item.ocr_pagina', { n: p.n })}</h3>}
                <div class="textcard" lang={contentLang()}>{p.text}</div>
              </div>
            ))}
          </details>
        </section>
      )}
      {!item.restricted && (
        <section class="section" aria-labelledby="transcripcion-t" data-tr-item={item.id} data-tr-items={trDoc?.items.join(' ')} hidden={!transcription}>
          <h2 id="transcripcion-t">{t('item.transcripcion_titulo')}</h2>
          <p class="muted small">{t('item.transcripcion_ayuda')}</p>
          {trSiblings.length > 0 && (
            <p class="small" data-tr-siblings>{t('item.transcripcion_conjunta', { n: trSiblings.length + 1 })} {trSiblings.map((s, i) => <>{i > 0 && ', '}<a href={url(`item/${s!.id}/`)} lang={contentLang()}>{s!.title}</a></>)}</p>
          )}
          {transcription ? <Transcripcion text={transcription} doc={trDoc!.id} /> : <div class="transcripcion" lang={contentLang()} data-doc=""></div>}
        </section>
      )}
      {!item.restricted && <p class="muted small" data-live="no_text" hidden={!item.no_text}>{t('item.sin_texto')}</p>}
      {!item.restricted && (
        <section class="section island-section" aria-labelledby="transcripciones-t" data-transcripciones hidden={contributed.length === 0}>
          <h2 id="transcripciones-t">{t('item.transcripciones_aportes')}</h2>
          <Mount id="transcripciones" festival={item.festival} year={item.year} item={item.id}>{contributed.length > 0 && (
            <ul class="recuerdos">
              {contributed.map((c) => <li><blockquote lang={contentLang()}>{String(c.payload?.text ?? '')}</blockquote>{byLine(c) && <p class="muted small">{byLine(c)}</p>}</li>)}
            </ul>
          )}</Mount>
          <script type="application/json" id="transcripciones-data" set:html={jsonForScript(contributed)}></script>
        </section>
      )}
    </div>

    <aside class="side">
      <section class="sourcecard" aria-labelledby="fuente-t">
        <h2 id="fuente-t">{t('item.fuente')}</h2>
        <p>
          {item.source_url
            ? <a href={item.source_url} rel="noopener noreferrer nofollow">{item.source_label}</a>
            : item.source_label}
        </p>
        {retrieved && <p class="muted small">{t('item.consultado', { fecha: retrieved })}</p>}
        <div data-live="rights" hidden={!item.rights}>
          <h3 class="small">{t('item.derechos')}</h3>
          <p class="small">{item.rights}</p>
        </div>
        <div data-live="caption" hidden={!item.note_public}>
          <h3 class="small">{t('item.nota')}</h3>
          <p class="small" lang={contentLang()}>{item.note_public}</p>
        </div>
        {!item.restricted && (
          <div class="island-section notas">
            <h3 class="small">{t('item.notas_titulo')}</h3>
            <Mount id="notas" festival={item.festival} year={item.year} item={item.id}>{notes.length > 0 && (
              <ul class="recuerdos">
                {notes.map((c) => <li><blockquote lang={contentLang()}>{String(c.payload?.text ?? '')}</blockquote>{byLine(c) && <p class="muted small">{byLine(c)}</p>}</li>)}
              </ul>
            )}</Mount>
            <script type="application/json" id="notas-data" set:html={jsonForScript(notes)}></script>
          </div>
        )}
      </section>
      {!item.restricted && (
        <section class="island-section" aria-labelledby="tarea-t" data-pagefind-ignore="all">
          <h2 id="tarea-t" class="small">{t('item.tarea_titulo')}</h2>
          <Mount id="tarea" festival={item.festival} year={item.year} item={item.id} category={item.category} />
        </section>
      )}
      <Mount id="admin-item" festival={item.festival} year={item.year} item={item.id} category={item.category} class="admin-item" />
    </aside>
  </div>
</Base>

<script>
  import '../../scripts/tarea.ts';
  import '../../scripts/liberado.ts';
  import '../../scripts/transcripciones.ts';
  import '../../scripts/live-transcripciones.ts';
  import '../../scripts/admin-item.ts';
</script>
