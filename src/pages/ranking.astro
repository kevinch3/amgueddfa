---
import Base from '../layouts/Base.astro';
import { FESTIVALS } from '../lib/contrib';
import { t } from '../lib/i18n';
---
<Base title={t('ranking.titulo')} current="ranking">
  <section class="ranking measure">
    <h1>{t('ranking.titulo')}</h1>
    <p class="lead">{t('ranking.intro')}</p>
    <div class="campo">
      <label for="r-filtro">{t('ranking.filtro')}</label>
      <select id="r-filtro">
        <option value="">{t('ranking.general')}</option>
        {FESTIVALS.map((f) => <option value={f}>{t(`festivales.${f}`)}</option>)}
      </select>
    </div>
    <div id="ranking" aria-live="polite"><p class="muted">{t('ranking.cargando')}</p></div>
  </section>
</Base>

<script>
  import { FESTIVALS } from '../lib/contrib';
  import { rankBy, type LeaderRow } from '../lib/game';
  import { formatNumber, t } from '../lib/i18n';
  import { liveQuery, withOptionalCols } from '../lib/live';
  import { countryName, flag } from '../lib/places';
  import { url } from '../lib/paths';
  import type { FestivalSlug } from '../lib/types';
  import { el } from '../scripts/ui';

  const mount = document.getElementById('ranking')!;
  const sel = document.getElementById('r-filtro') as HTMLSelectElement;
  const params = new URLSearchParams(location.search);
  if ((FESTIVALS as string[]).includes(params.get('f') ?? '')) sel.value = params.get('f')!;

  let rows: LeaderRow[] = [];
  let offline = false;

  function render() {
    mount.replaceChildren();
    if (offline) {
      mount.append(el('p', { class: 'contrib-msg' }, t('estado.sin_conexion')));
      return;
    }
    const f = (sel.value || null) as FestivalSlug | null;
    const ranked = rankBy(rows, f);
    if (!ranked.length) {
      mount.append(el('p', { class: 'muted' }, t('ranking.vacio')));
      return;
    }
    const label = f ? t(`festivales.${f}`) : t('ranking.general');
    const table = el('table', { class: 'ranking-tabla' });
    table.append(el('caption', { class: 'sr-only' }, t('ranking.tabla', { filtro: label })));
    const head = el('tr');
    head.append(el('th', { scope: 'col' }, t('ranking.puesto')), el('th', { scope: 'col' }, t('ranking.nombre')), el('th', { scope: 'col' }, t('ranking.puntos')));
    table.append(el('thead'));
    table.tHead!.append(head);
    const body = el('tbody');
    for (const r of ranked) {
      const tr = el('tr', r.rank <= 3 ? { class: 'podio' } : {});
      const name = el('td');
      name.append(el('a', { href: url(`perfil?u=${encodeURIComponent(r.display_name)}`) }, r.display_name));
      const cc = r.country;
      if (flag(cc)) name.append(' ', el('span', { class: 'bandera', title: countryName(cc), role: 'img', 'aria-label': countryName(cc) }, flag(cc)));
      tr.append(el('td', { class: 'num' }, String(r.rank)), name, el('td', { class: 'num' }, formatNumber(r.points)));
      body.append(tr);
    }
    table.append(body);
    mount.append(table);
  }

  sel.addEventListener('change', () => {
    const u = new URL(location.href);
    if (sel.value) u.searchParams.set('f', sel.value);
    else u.searchParams.delete('f');
    history.replaceState(null, '', u);
    render();
  });

  async function load() {
    const live = await liveQuery<LeaderRow[]>(
      (c) => withOptionalCols((cols) => c.from('leaderboard').select(cols).limit(1000), 'display_name, points, festival_points', 'country'),
      [],
    );
    rows = live.data;
    offline = live.offline;
    render();
  }
  void load();
</script>

<style is:global>
  .ranking-tabla { width: 100%; border-collapse: collapse; font-family: var(--sans); margin: 1rem 0; }
  .ranking-tabla th, .ranking-tabla td { text-align: left; padding: 0.55rem 0.6rem; border-bottom: 1px solid var(--rule); }
  .ranking-tabla th { font-weight: 600; border-bottom: 2px solid var(--red); }
  .ranking-tabla .num { font-variant-numeric: tabular-nums; width: 5rem; }
  .ranking-tabla th:last-child, .ranking-tabla td:last-child { text-align: right; }
  .ranking-tabla .podio td:first-child { color: var(--gold-ink); font-weight: 700; }
</style>
